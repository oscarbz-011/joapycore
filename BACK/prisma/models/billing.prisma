enum InvoiceStatus {
  PENDING
  ISSUED
  PAID
  CANCELLED
}

// SALE = factura de venta normal (flujo de siempre). INTEREST = factura
// generada automáticamente por los intereses moratorios cobrados en un pago
// de cuota — sin saleOrderId (ver Invoice.saleOrderId), referenciada por
// paymentReceiptId en su lugar.
enum InvoiceType {
  SALE
  INTEREST
}

enum BillingDocumentType {
  INVOICE
  CREDIT_NOTE
  REMISSION_NOTE
}

// Motivos de traslado del art. 32 del Decreto 6539/05 (los mismos que usa la
// nota de remisión electrónica).
enum RemissionMotive {
  SALE
  CONSIGNMENT
  EXPORT
  PURCHASE
  IMPORT
  RETURN
  BRANCH_TRANSFER
  TRANSFORMATION
  REPAIR
  MOBILE_ISSUER
  EXHIBITION
  TRADE_FAIR
  OTHER
}

enum RemissionNoteStatus {
  ISSUED
  VOIDED
}

enum TransportType {
  OWN
  THIRD_PARTY
}

// Traslado entre depósitos: sale del origen al emitir la nota y entra al
// destino recién cuando allá se confirma lo que llegó.
enum RemissionTransitStatus {
  IN_TRANSIT
  RECEIVED
  RECEIVED_WITH_DIFFERENCES
}

// Quién numera y qué vale como comprobante: PREPRINTED = talonario de
// imprenta (el número lo carga el usuario), SELF_PRINTED = autoimpresor (lo
// asigna el sistema), ELECTRONIC = SIFEN.
enum BillingModality {
  PREPRINTED
  SELF_PRINTED
  ELECTRONIC
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
}

// TOTAL anula la operación entera; ITEMS acepta la devolución de ítems
// facturados; AMOUNT concede un descuento o bonificación por un importe.
enum CreditNoteKind {
  TOTAL
  ITEMS
  AMOUNT
}

// Movimientos del saldo a favor de un cliente: se suma con una nota de
// crédito o una factura anulada ya cobrada, y se resta al aplicarlo.
enum CustomerCreditSource {
  CREDIT_NOTE
  INVOICE_VOID
  APPLIED
}

enum BillingEventType {
  ISSUED
  NUMBERED
  FORM_PRINTED
  SHEET_VOIDED
  SCAN_ATTACHED
  SCAN_REMOVED
  VOIDED
  CREDIT_NOTE_ISSUED
  REMISSION_NOTE_ISSUED
  REMISSION_RECEIVED
  REFUNDED
  CUSTOMER_CREDITED
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  // Null para invoiceType=INTEREST (no corresponde a ningún pedido de venta,
  // se referencia por paymentReceiptId en su lugar) — sigue @unique porque
  // Postgres permite múltiples NULL bajo un unique, así que la garantía "una
  // sola factura de venta por pedido" queda intacta.
  saleOrderId String?       @unique @map("sale_order_id")
  invoiceType InvoiceType   @default(SALE) @map("invoice_type")
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime?     @map("issued_at")
  dueDate     DateTime?     @map("due_date")
  total       Decimal       @db.Decimal(23, 8)
  // dRedon: lo que se descontó al redondear hacia abajo a 50 la parte pagada
  // en efectivo. `total` sigue siendo la suma de las líneas; se cobró
  // total - rounding.
  rounding    Decimal       @default(0) @db.Decimal(23, 8)
  notes       String?

  // Solo para invoiceType=INTEREST: qué recibo de cobro generó esta factura.
  paymentReceiptId String? @unique @map("payment_receipt_id")

  // Numeración: sale de la serie al emitir. La serie, el timbrado y su
  // vigencia se copian a la factura para que lo impreso no cambie si después
  // se edita la serie. invoiceNumber/invoicePrefix son el texto para mostrar
  // ("001-002-0000123").
  seriesId           String?          @map("series_id")
  modality           BillingModality?
  timbrado           String?
  timbradoValidFrom  DateTime?        @map("timbrado_valid_from")
  timbradoValidUntil DateTime?        @map("timbrado_valid_until")
  serieCode          String           @default("") @map("serie_code")
  establecimiento    String?          @map("establecimiento")
  puntoExpedicion    String?          @map("punto_expedicion")
  sequential         Int?             @map("sequential")
  invoiceNumber      String?          @map("invoice_number")
  invoicePrefix      String?          @map("invoice_prefix")

  // Payment details (populated on issue)
  paymentMethod PaymentMethod? @map("payment_method")

  // PDF storage — pdfUrl queda reservado para la copia alojada por SIFEN
  // cuando exista facturación electrónica; pdfFileId es el PDF interno
  // generado hoy desde la plantilla del tenant (módulo Documentos).
  pdfUrl    String?     @map("pdf_url")
  pdfFileId String?     @unique @map("pdf_file_id")
  pdfFile   FileRecord? @relation("InvoicePdf", fields: [pdfFileId], references: [id])

  // Talonario de imprenta: el comprobante es la hoja preimpresa. Se registra
  // cuántas veces se imprimió sobre ella y se puede adjuntar su escaneo.
  formPrintCount     Int         @default(0) @map("form_print_count")
  formPrintedAt      DateTime?   @map("form_printed_at")
  physicalScanFileId String?     @unique @map("physical_scan_file_id")
  physicalScan       FileRecord? @relation("InvoicePhysicalScan", fields: [physicalScanFileId], references: [id])

  // Consumidor final que no se identificó: la factura lleva "Sin Nombre" y
  // una X en RUC y documento (art. 20 del Decreto 6539/05).
  anonymousBuyer Boolean @default(false) @map("anonymous_buyer")

  // Suma de las notas de crédito emitidas sobre la factura: nunca supera el
  // total. El estado de cobro sigue en `status`.
  creditedTotal Decimal   @default(0) @map("credited_total") @db.Decimal(23, 8)
  // Anulada conservando el original y las copias (sin nota de crédito).
  voidReason    String?   @map("void_reason")
  voidedAt      DateTime? @map("voided_at")

  // SIFEN / e-billing fields (null until electronic billing integration)
  cdc          String? // Código de Control Digital
  xmlContent   String?   @map("xml_content")
  qrUrl        String?   @map("qr_url")
  electronicAt DateTime? @map("electronic_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  saleOrder          SaleOrder?             @relation(fields: [saleOrderId], references: [id])
  paymentReceipt     PaymentReceipt?        @relation(fields: [paymentReceiptId], references: [id])
  series             BillingSeries?         @relation(fields: [seriesId], references: [id])
  items              InvoiceItem[]
  accountsReceivable AccountsReceivable?
  creditNotes        CreditNote[]
  remissionNotes     RemissionNote[]
  voidedSheets       BillingVoidedNumber[]
  events             BillingDocumentEvent[]
  refunds            BillingRefund[]
  customerCredits    CustomerCreditEntry[]

  @@unique([seriesId, serieCode, sequential])
  @@index([tenantId, seriesId])
  @@map("invoices")
}

// Timbrado o configuración de numeración de un establecimiento y punto de
// expedición para un tipo de documento. No se borra: se desactiva.
model BillingSeries {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  branchId        String              @map("branch_id")
  documentType    BillingDocumentType @default(INVOICE) @map("document_type")
  modality        BillingModality
  // Null solo en series migradas de un tenant que no había cargado su
  // timbrado: emitir queda bloqueado hasta completarlo.
  timbrado        String?
  // Días de calendario (medianoche UTC). El timbrado electrónico no vence.
  validFrom       DateTime?           @map("valid_from")
  validUntil      DateTime?           @map("valid_until")
  establecimiento String
  puntoExpedicion String              @map("punto_expedicion")
  // Serie de dos letras del timbrado electrónico; vacío mientras no se use.
  serieCode       String              @default("") @map("serie_code")
  rangeFrom       Int                 @map("range_from")
  rangeTo         Int                 @map("range_to")
  // SELF_PRINTED: el próximo número a asignar. PREPRINTED: el siguiente
  // sugerido al cargar el número del talonario.
  nextNumber      Int                 @map("next_number")
  isActive        Boolean             @default(true) @map("is_active")
  // Talonario: dónde va cada dato sobre la hoja preimpresa (en mm). Null =
  // diseño estándar.
  printLayout     Json?               @map("print_layout")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  branch         Branch                @relation(fields: [branchId], references: [id])
  invoices       Invoice[]
  creditNotes    CreditNote[]
  remissionNotes RemissionNote[]
  posTerminals   PosTerminal[]
  voidedNumbers  BillingVoidedNumber[]

  @@unique([tenantId, timbrado, establecimiento, puntoExpedicion, documentType, serieCode])
  @@index([tenantId, branchId, documentType, isActive])
  @@map("billing_series")
}

// Hoja de un talonario de imprenta que no se usó como factura (se arruinó al
// imprimir, se extravió, etc.). Su número no se puede volver a usar.
model BillingVoidedNumber {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  seriesId   String   @map("series_id")
  serieCode  String   @default("") @map("serie_code")
  sequential Int
  // La factura que estaba impresa en la hoja, si había una.
  invoiceId  String?  @map("invoice_id")
  reason     String
  scanFileId String?  @unique @map("scan_file_id")
  voidedById String?  @map("voided_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  series   BillingSeries @relation(fields: [seriesId], references: [id])
  invoice  Invoice?      @relation(fields: [invoiceId], references: [id])
  scanFile FileRecord?   @relation("VoidedSheetScan", fields: [scanFileId], references: [id])

  @@unique([seriesId, serieCode, sequential])
  @@index([tenantId, seriesId])
  @@map("billing_voided_numbers")
}

model InvoiceItem {
  tenantId    String  @map("tenant_id")
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(18, 8)
  unitPrice   Decimal @map("unit_price") @db.Decimal(23, 8)
  total       Decimal @db.Decimal(23, 8)

  // IVA breakdown
  ivaRate             Decimal? @map("iva_rate") @db.Decimal(11, 8)
  ivaAmount           Decimal? @map("iva_amount") @db.Decimal(23, 8)
  unitPriceWithoutIva Decimal? @map("unit_price_without_iva") @db.Decimal(23, 8)

  // Ítem del pedido que facturó: hace falta para reingresar al stock lo que
  // devuelve una nota de crédito.
  saleOrderItemId String? @map("sale_order_item_id")

  invoice         Invoice             @relation(fields: [invoiceId], references: [id])
  creditNoteItems CreditNoteItem[]
  remissionItems  RemissionNoteItem[]

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_items")
}

model CreditNote {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  invoiceId String           @map("invoice_id")
  // Siete dígitos de la serie ("0000012"); las notas anteriores a las series
  // conservan su "NC-0001".
  number    String?          @map("number")
  reason    String
  total     Decimal          @db.Decimal(23, 8)
  status    CreditNoteStatus @default(ISSUED)
  kind      CreditNoteKind   @default(TOTAL)
  issuedAt  DateTime         @default(now()) @map("issued_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at")

  // Numeración: igual que la factura, se copia de la serie al emitir.
  seriesId           String?          @map("series_id")
  modality           BillingModality?
  timbrado           String?
  timbradoValidFrom  DateTime?        @map("timbrado_valid_from")
  timbradoValidUntil DateTime?        @map("timbrado_valid_until")
  serieCode          String           @default("") @map("serie_code")
  establecimiento    String?
  puntoExpedicion    String?          @map("punto_expedicion")
  sequential         Int?
  numberPrefix       String?          @map("number_prefix")

  customerId       String? @map("customer_id")
  issuedById       String? @map("issued_by_id")
  // Parte del importe que descontó lo que el cliente debía. El resto quedó
  // como saldo a favor o se devolvió (CustomerCreditEntry / BillingRefund).
  appliedToBalance Decimal @default(0) @map("applied_to_balance") @db.Decimal(23, 8)

  pdfFileId          String?     @unique @map("pdf_file_id")
  pdfFile            FileRecord? @relation("CreditNotePdf", fields: [pdfFileId], references: [id])
  formPrintCount     Int         @default(0) @map("form_print_count")
  formPrintedAt      DateTime?   @map("form_printed_at")
  physicalScanFileId String?     @unique @map("physical_scan_file_id")
  physicalScan       FileRecord? @relation("CreditNotePhysicalScan", fields: [physicalScanFileId], references: [id])

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  invoice         Invoice                @relation(fields: [invoiceId], references: [id])
  series          BillingSeries?         @relation(fields: [seriesId], references: [id])
  customer        Customer?              @relation(fields: [customerId], references: [id])
  items           CreditNoteItem[]
  events          BillingDocumentEvent[]
  refunds         BillingRefund[]
  customerCredits CustomerCreditEntry[]

  @@unique([seriesId, serieCode, sequential])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteItem {
  tenantId        String   @map("tenant_id")
  id              String   @id @default(uuid())
  creditNoteId    String   @map("credit_note_id")
  invoiceItemId   String?  @map("invoice_item_id")
  description     String
  quantity        Decimal @db.Decimal(18, 8)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(23, 8)
  total           Decimal  @db.Decimal(23, 8)
  ivaRate         Decimal? @map("iva_rate") @db.Decimal(11, 8)
  ivaAmount       Decimal? @map("iva_amount") @db.Decimal(23, 8)
  // Cuánto de lo devuelto volvió al stock y con qué números de serie.
  restockQuantity Decimal  @default(0) @map("restock_quantity") @db.Decimal(18, 8)
  serialNumbers   String[] @default([]) @map("serial_numbers")

  creditNote  CreditNote   @relation(fields: [creditNoteId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])

  @@index([creditNoteId])
  @@index([invoiceItemId])
  @@index([tenantId])
  @@map("credit_note_items")
}

// Saldo a favor del cliente: la suma de sus movimientos.
model CustomerCreditEntry {
  id           String               @id @default(uuid())
  tenantId     String               @map("tenant_id")
  customerId   String               @map("customer_id")
  // Positivo suma saldo a favor; negativo lo consume.
  amount       Decimal              @db.Decimal(23, 8)
  source       CustomerCreditSource
  creditNoteId String?              @map("credit_note_id")
  invoiceId    String?              @map("invoice_id")
  note         String?
  createdById  String?              @map("created_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, customerId])
  @@map("customer_credit_entries")
}

// Dinero devuelto al cliente por una nota de crédito o una factura anulada
// ya cobrada.
model BillingRefund {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  creditNoteId String?       @map("credit_note_id")
  invoiceId    String?       @map("invoice_id")
  amount       Decimal       @db.Decimal(23, 8)
  method       PaymentMethod
  reference    String?
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("billing_refunds")
}

// Historial fiscal de una factura o nota de crédito.
model BillingDocumentEvent {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  invoiceId       String?          @map("invoice_id")
  creditNoteId    String?          @map("credit_note_id")
  remissionNoteId String?          @map("remission_note_id")
  type            BillingEventType
  detail          Json?
  userId          String?          @map("user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  creditNote    CreditNote?    @relation(fields: [creditNoteId], references: [id])
  remissionNote RemissionNote? @relation(fields: [remissionNoteId], references: [id])

  @@index([tenantId, invoiceId, createdAt])
  @@index([tenantId, creditNoteId, createdAt])
  @@index([tenantId, remissionNoteId, createdAt])
  @@map("billing_document_events")
}

// Nota de remisión (arts. 30–48 del Decreto 6539/05): sustenta el traslado de
// mercadería. Obligatoria entre sucursales; en una venta es opcional si la
// mercadería viaja con la factura (art. 38).
model RemissionNote {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  branchId     String              @map("branch_id")
  motive       RemissionMotive
  motiveDetail String?             @map("motive_detail")
  status       RemissionNoteStatus @default(ISSUED)

  transitStatus  RemissionTransitStatus? @map("transit_status")
  receivedAt     DateTime?               @map("received_at")
  receivedById   String?                 @map("received_by_id")
  receptionNotes String?                 @map("reception_notes")

  invoiceId       String? @map("invoice_id")
  fromWarehouseId String? @map("from_warehouse_id")
  toWarehouseId   String? @map("to_warehouse_id")

  customerId        String? @map("customer_id")
  recipientName     String  @map("recipient_name")
  recipientDocument String  @map("recipient_document")

  originAddress         String  @map("origin_address")
  originCity            String? @map("origin_city")
  originDepartment      String? @map("origin_department")
  destinationAddress    String  @map("destination_address")
  destinationCity       String? @map("destination_city")
  destinationDepartment String? @map("destination_department")

  transportType      TransportType @map("transport_type")
  vehicleBrand       String        @map("vehicle_brand")
  vehiclePlate       String        @map("vehicle_plate")
  trailerPlate       String?       @map("trailer_plate")
  carrierName        String        @map("carrier_name")
  carrierRuc         String        @map("carrier_ruc")
  carrierAddress     String        @map("carrier_address")
  driverName         String        @map("driver_name")
  driverDocument     String        @map("driver_document")
  driverAddress      String        @map("driver_address")
  // Días de calendario (medianoche UTC), como la vigencia del timbrado.
  transportStartDate DateTime      @map("transport_start_date")
  transportEndDate   DateTime      @map("transport_end_date")
  notes              String?

  seriesId           String          @map("series_id")
  modality           BillingModality
  timbrado           String
  timbradoValidFrom  DateTime?       @map("timbrado_valid_from")
  timbradoValidUntil DateTime?       @map("timbrado_valid_until")
  serieCode          String          @default("") @map("serie_code")
  establecimiento    String
  puntoExpedicion    String          @map("punto_expedicion")
  sequential         Int
  numberPrefix       String          @map("number_prefix")
  number             String

  issuedAt   DateTime  @default(now()) @map("issued_at")
  issuedById String?   @map("issued_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason")
  voidedById String?   @map("voided_by_id")

  pdfFileId          String?     @unique @map("pdf_file_id")
  pdfFile            FileRecord? @relation("RemissionNotePdf", fields: [pdfFileId], references: [id])
  physicalScanFileId String?     @unique @map("physical_scan_file_id")
  physicalScan       FileRecord? @relation("RemissionNotePhysicalScan", fields: [physicalScanFileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  branch        Branch                 @relation(fields: [branchId], references: [id])
  series        BillingSeries          @relation(fields: [seriesId], references: [id])
  invoice       Invoice?               @relation(fields: [invoiceId], references: [id])
  customer      Customer?              @relation(fields: [customerId], references: [id])
  fromWarehouse Warehouse?             @relation("RemissionFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?             @relation("RemissionToWarehouse", fields: [toWarehouseId], references: [id])
  items         RemissionNoteItem[]
  events        BillingDocumentEvent[]

  @@unique([seriesId, serieCode, sequential])
  @@index([tenantId, issuedAt])
  @@index([tenantId, transitStatus])
  @@index([invoiceId])
  @@map("remission_notes")
}

model RemissionNoteItem {
  tenantId         String   @map("tenant_id")
  id               String   @id @default(uuid())
  remissionNoteId  String   @map("remission_note_id")
  productId        String?  @map("product_id")
  invoiceItemId    String?  @map("invoice_item_id")
  description      String
  unitCode         Int      @map("unit_code")
  quantity         Decimal @db.Decimal(18, 8)
  serialNumbers    String[] @default([]) @map("serial_numbers")
  // Lo que llegó al destino; null mientras el traslado está en tránsito.
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(18, 8)
  receivedSerials  String[] @default([]) @map("received_serials")

  remissionNote RemissionNote @relation(fields: [remissionNoteId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])
  invoiceItem   InvoiceItem?  @relation(fields: [invoiceItemId], references: [id])

  @@index([remissionNoteId])
  @@index([invoiceItemId])
  @@index([tenantId])
  @@map("remission_note_items")
}
