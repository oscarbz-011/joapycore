enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum EmployeeCount {
  RANGE_1_5    @map("1-5")
  RANGE_6_20   @map("6-20")
  RANGE_21_50  @map("21-50")
  RANGE_51_200 @map("51-200")
  RANGE_201    @map("201+")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Rubro del tenant. Era texto libre y solo servía para sembrar categorías por
// defecto; un typo en el registro dejaba al tenant sin defaults en silencio.
// Como ahora también decide el ProductKind por defecto, pasó a lista cerrada.
enum Industry {
  ELECTRODOMESTICOS
  FERRETERIA
  SUPERMERCADO
  MUEBLERIA
  SERVICIOS
  OTRO
}

enum MarkupMethod {
  PERCENTAGE
  FIXED
}

model Tenant {
  id       String       @id @default(uuid())
  name     String
  industry Industry?
  plan     String       @default("trial")
  status   TenantStatus @default(ACTIVE)

  // Company profile
  razonSocial    String?        @map("razon_social")
  nombreFantasia String?        @map("nombre_fantasia")
  ruc            String?
  address        String?
  numeroCasa     String?        @map("numero_casa")
  postalCode     String?        @map("postal_code")
  city           String?
  department     String?
  country        String         @default("Paraguay")
  phone          String?
  email          String?
  logoFileId     String?        @unique @map("logo_file_id")
  employeeCount  EmployeeCount? @map("employee_count")
  currency       String         @default("PYG")

  // SIFEN — datos fiscales
  tipoContribuyente     Int?  @map("tipo_contribuyente") // 1=Física 2=Jurídica
  tipoRegimen           Int?  @map("tipo_regimen") // 8=IVA General, etc.
  actividadesEconomicas Json? @map("actividades_economicas") // [{codigo, descripcion}]

  // SIFEN — dirección estructurada (códigos SET)
  departamentoCodigo Int?    @map("departamento_codigo")
  departamentoDesc   String? @map("departamento_desc")
  distritoCodigo     Int?    @map("distrito_codigo")
  distritoDesc       String? @map("distrito_desc")
  ciudadCodigo       Int?    @map("ciudad_codigo")
  ciudadDesc         String? @map("ciudad_desc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logoFile                   FileRecord?                 @relation("TenantLogo", fields: [logoFileId], references: [id])
  users                      User[]
  roles                      Role[]
  tenantModules              TenantModule[]
  moduleData                 TenantModuleData[]
  creditNotes                CreditNote[]
  branches                   Branch[]
  warehouses                 Warehouse[]
  loans                      Loan[]
  installments               Installment[]
  categories                 Category[]
  brands                     Brand[]
  products                   Product[]
  productSuppliers           ProductSupplier[]
  productUnits               ProductUnit[]
  productBatches             ProductBatch[]
  productComponents          ProductComponent[]
  productionOrders           ProductionOrder[]
  supplierCatalogItems       SupplierCatalogItem[]
  stockMovements             StockMovement[]
  posTerminals               PosTerminal[]
  posSessions                PosSession[]
  customers                  Customer[]
  suppliers                  Supplier[]
  purchaseOrders             PurchaseOrder[]
  purchaseReceipts           PurchaseReceipt[]
  purchaseOrderStatusChanges PurchaseOrderStatusChange[]
  saleOrders                 SaleOrder[]
  invoices                   Invoice[]
  accountsReceivable         AccountsReceivable[]
  paymentRecords             PaymentRecord[]
  accountsPayable            AccountsPayable[]
  supplierPayments           SupplierPayment[]
  supplierInvoices           SupplierInvoice[]
  areas                      Area[]
  positions                  Position[]
  employees                  Employee[]
  payrollConfig              PayrollConfig?
  payrollRecords             PayrollRecord[]
  auditLogs                  AuditLog[]
  alertConfigs               AlertConfig[]
  fileRecords                FileRecord[]
  documents                  Document[]
  documentCategories         DocumentCategory[]
  creditConfig               CreditConfig?
  pricingConfig              PricingConfig?
  salesConfig                SalesConfig?
  saleCombos                 SaleCombo[]
  saleTargets                SaleTarget[]
  downPayments               DownPayment[]
  salePayments               SalePayment[]
  deliveryNotes              DeliveryNote[]
  platformEmailMessages      PlatformEmailMessage[]
  deliveryRoutes             DeliveryRoute[]
  deliveryRouteEvents        DeliveryRouteEvent[]
  deliveryTrackingEvents     DeliveryTrackingEvent[]
  collectionRoutes           CollectionRoute[]
  collectionVisits           CollectionVisit[]
  paymentAgreements          PaymentAgreement[]
  collectionNotes            CollectionNote[]
  sifenConfig                SifenConfig?
  guarantors                 Guarantor[]
  creditBureauConfig         CreditBureauConfig?
  creditBureauChecks         CreditBureauCheck[]
  paymentReceipts            PaymentReceipt[]
  interestComponents         InterestComponent[]
  delinquencyReports         DelinquencyReport[]
  integrations               TenantIntegration[]
  appEmailMessages           AppEmailMessage[]
  appEmailInboxMessages      AppEmailInboxMessage[]
  billingSeries              BillingSeries[]
  billingVoidedNumbers       BillingVoidedNumber[]
  customerCreditEntries      CustomerCreditEntry[]
  billingRefunds             BillingRefund[]
  billingDocumentEvents      BillingDocumentEvent[]
  remissionNotes             RemissionNote[]

  @@map("tenants")
}

model TenantModule {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  moduleName  String    @map("module_name")
  active      Boolean   @default(false)
  activatedAt DateTime? @map("activated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleName])
  @@map("tenant_modules")
}

// Última versión de cada conjunto de datos iniciales que recibió la empresa.
model TenantModuleData {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  dataSet   String   @map("data_set")
  version   Int
  appliedAt DateTime @default(now()) @map("applied_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dataSet])
  @@map("tenant_module_data")
}

model User {
  id                    String     @id @default(uuid())
  tenantId              String     @map("tenant_id")
  branchId              String?    @map("branch_id")
  email                 String     @unique
  username              String?    @unique
  passwordHash          String     @map("password_hash")
  firstName             String     @map("first_name")
  lastName              String     @map("last_name")
  phone                 String?    @map("phone")
  status                UserStatus @default(ACTIVE)
  mustChangePassword    Boolean    @default(false) @map("must_change_password")
  tempPasswordEncrypted String?    @map("temp_password_encrypted")
  tempPasswordExpiresAt DateTime?  @map("temp_password_expires_at")
  lastLoginAt           DateTime?  @map("last_login_at")
  // Tokens (access y refresh) emitidos antes de este momento dejan de valer:
  // se actualiza al cambiar/resetear la contraseña o desactivar el usuario.
  sessionsValidAfter    DateTime?  @map("sessions_valid_after")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  tenant                         Tenant                      @relation(fields: [tenantId], references: [id])
  branch                         Branch?                     @relation(fields: [branchId], references: [id])
  userRoles                      UserRole[]
  userPermissions                UserPermission[]
  refreshTokens                  RefreshToken[]
  employee                       Employee?
  auditLogs                      AuditLog[]
  createdSaleOrders              SaleOrder[]                 @relation("SaleCreator")
  selledSaleOrders               SaleOrder[]                 @relation("SaleSeller")
  approvedSaleOrders             SaleOrder[]                 @relation("CreditApprover")
  rejectedSaleOrders             SaleOrder[]                 @relation("CreditRejecter")
  registeredDownPayments         DownPayment[]               @relation("DownPaymentRegistrar")
  collectedSalePayments          SalePayment[]               @relation("SalePaymentCollector")
  saleTargets                    SaleTarget[]
  collectionRoutesAsCollector    CollectionRoute[]           @relation("RouteCollector")
  closedCollectionRoutes         CollectionRoute[]           @relation("RouteClosedBy")
  createdCollectionRoutes        CollectionRoute[]           @relation("RouteCreatedBy")
  approvedAgreements             PaymentAgreement[]          @relation("AgreementApprovedBy")
  createdAgreements              PaymentAgreement[]          @relation("AgreementCreatedBy")
  createdCollectionNotes         CollectionNote[]            @relation("NoteCreatedBy")
  posSessionsAsCashier           PosSession[]                @relation("SessionCashier")
  collectedPaymentReceipts       PaymentReceipt[]
  createdPurchaseReceipts        PurchaseReceipt[]
  purchaseOrderStatusChanges     PurchaseOrderStatusChange[]
  createdProductionOrders        ProductionOrder[]
  recordedDeliveryTrackingEvents DeliveryTrackingEvent[]
  createdSupplierPayments        SupplierPayment[]
  reviewedDelinquencyReports     DelinquencyReport[]         @relation("DelinquencyReportReviewedBy")
  sentAppEmailMessages           AppEmailMessage[]           @relation("AppEmailSender")
  supplierInvoicesCreated        SupplierInvoice[]           @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesReviewed       SupplierInvoice[]           @relation("SupplierInvoiceReviewedBy")
  deliverySellerRequests         DeliveryNote[]              @relation("DeliverySellerRequester")
  deliverySellerDecisions        DeliveryNote[]              @relation("DeliverySellerDecider")
  createdDeliveryRoutes          DeliveryRoute[]             @relation("DeliveryRouteCreatedBy")
  deliveryRouteEvents            DeliveryRouteEvent[]        @relation("DeliveryRouteEventUser")

  @@index([tenantId])
  @@map("users")
}

model UserPermission {
  tenantId     String @map("tenant_id")
  userId       String @map("user_id")
  permissionId String @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([tenantId])
  @@map("user_permissions")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isSystem Boolean @default(false) @map("is_system")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  positions       Position[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  tenantId     String @map("tenant_id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  roleId   String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  module     String
  action     String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, module])
  @@map("audit_logs")
}

enum FileVisibility {
  PUBLIC // servible por URL directa/CDN, sin pasar por el endpoint autenticado
  PRIVATE // solo accesible vía GET /files/:id/download (permiso files:read)
}

model FileRecord {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  module       String
  entityType   String         @map("entity_type")
  entityId     String?        @map("entity_id")
  bucket       String         @default("local")
  key          String
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  uploadedBy   String?        @map("uploaded_by")
  url          String?
  checksum     String?
  visibility   FileVisibility @default(PRIVATE)
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  document          Document?
  tenantLogo        Tenant?              @relation("TenantLogo")
  invoiceFor        Invoice?             @relation("InvoicePdf")
  invoiceScanFor    Invoice?             @relation("InvoicePhysicalScan")
  voidedSheetFor    BillingVoidedNumber? @relation("VoidedSheetScan")
  creditNotePdfFor  CreditNote?          @relation("CreditNotePdf")
  creditNoteScanFor CreditNote?          @relation("CreditNotePhysicalScan")
  remissionPdfFor   RemissionNote?       @relation("RemissionNotePdf")
  remissionScanFor  RemissionNote?       @relation("RemissionNotePhysicalScan")
  receiptFor        PaymentReceipt?      @relation("ReceiptPdf")
  posPaperReportFor PosTerminal[]        @relation("PosPaperReport")

  @@index([tenantId, module, entityType, entityId])
  @@map("file_records")
}

model CreditConfig {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique @map("tenant_id")
  isEnabled                Boolean  @default(false) @map("is_enabled")
  // % máximo del sueldo del cliente admitido para cuota mensual de crédito —
  // null = el chequeo de capacidad de pago por sueldo no corre.
  maxIncomePercentage      Decimal? @map("max_income_percentage") @db.Decimal(11, 8)
  // Día del mes (1-28, evita problemas de meses cortos) en que vencen todas
  // las cuotas de todos los créditos del tenant — no depende de la fecha de
  // compra de cada cliente.
  dueDayOfMonth            Int      @default(5) @map("due_day_of_month")
  // Días de tolerancia después del vencimiento antes de empezar a devengar
  // mora (0 = sin tolerancia, se cobra desde el día siguiente al vencimiento).
  moraGraceDays            Int      @default(0) @map("mora_grace_days")
  // Días de mora (desde que vence la tolerancia) a partir de los cuales un
  // cliente entra a la lista de Morosos para gestionar su reporte a
  // Informconf. null = deshabilitado.
  delinquencyThresholdDays Int?     @map("delinquency_threshold_days")
  // Calificación del cliente (1 = paga al día … 5): límite superior de días
  // de atraso promedio de los niveles 1 a 4; por encima del último es nivel 5.
  ratingDelayThresholds    Int[]    @default([0, 5, 15, 30]) @map("rating_delay_thresholds")
  // Días de atraso de una cuota impaga a partir de los cuales el cliente pasa
  // solo a nivel 6 (incobrable/judicial). null = solo por marca manual.
  uncollectibleAfterDays   Int?     @map("uncollectible_after_days")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  plans              CreditPlan[]
  interestComponents InterestComponent[]

  @@map("credit_configs")
}

model SalesConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id")
  combosEnabled Boolean  @default(false) @map("combos_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("sales_config")
}

model CreditPlan {
  tenantId       String   @map("tenant_id")
  id             String   @id @default(uuid())
  creditConfigId String   @map("credit_config_id")
  installments   Int
  interestRate   Decimal  @map("interest_rate") @db.Decimal(11, 8)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  creditConfig CreditConfig @relation(fields: [creditConfigId], references: [id])

  @@unique([creditConfigId, installments])
  @@index([tenantId])
  @@map("credit_plans")
}

enum InterestComponentFrequency {
  ONE_TIME // se cobra una vez, no crece con el tiempo (ej. gastos administrativos)
  DAILY // se acumula por día de atraso (ej. interés diario)
  MONTHLY // se aplica por cada período de 30 días iniciado desde el primer día de mora
}

// Cada tenant define sus propios recargos por mora — pueden coexistir varios
// a la vez (ej. gastos administrativos ONE_TIME + interés diario DAILY), tal
// como lo pidió el usuario. Reemplaza por completo al viejo
// CreditConfig.moraRate, que nunca se expuso por API/UI y nunca se cobró.
model InterestComponent {
  id             String                     @id @default(uuid())
  tenantId       String                     @map("tenant_id")
  creditConfigId String                     @map("credit_config_id")
  name           String
  frequency      InterestComponentFrequency
  // Decimal(7,4): permite tasas menores a 1% (ej. mora diaria de 0,001%)
  // sin redondearlas a 0 — antes era Decimal(5,2), que solo admitía 2
  // decimales.
  percentage     Decimal                    @db.Decimal(11, 8)
  // Solo aplica a MONTHLY: si true, el cargo crece con cada período vencido
  // (mes 1=10%, mes 2=20%, mes 3=30% — acumulación lineal, no interés
  // compuesto). Si false, se cobra el % base una sola vez apenas se cruza
  // el primer día de mora y no vuelve a crecer. DAILY siempre es acumulativo
  // por diseño (más días = más interés); ONE_TIME nunca lo es.
  cumulative     Boolean                    @default(false)
  isActive       Boolean                    @default(true) @map("is_active")
  order          Int                        @default(0)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  creditConfig CreditConfig                @relation(fields: [creditConfigId], references: [id])
  charges      InstallmentInterestCharge[]

  @@index([tenantId])
  @@index([creditConfigId])
  @@map("interest_components")
}

model PricingConfig {
  id            String       @id @default(uuid())
  tenantId      String       @unique @map("tenant_id")
  markupMethod  MarkupMethod @default(PERCENTAGE) @map("markup_method")
  defaultMarkup Decimal      @map("default_markup") @db.Decimal(23, 8)
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("pricing_configs")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// Una integración es una conexión opcional por tenant, no un módulo de negocio.
// `key` queda como texto para poder sumar proveedores sin migrar un enum.
model TenantIntegration {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  key             String
  enabled         Boolean           @default(false)
  status          IntegrationStatus @default(DISCONNECTED)
  encryptedConfig String?           @map("encrypted_config") @db.Text
  lastTestedAt    DateTime?         @map("last_tested_at")
  lastTestOk      Boolean?          @map("last_test_ok")
  lastError       String?           @map("last_error")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, enabled])
  @@map("tenant_integrations")
}

enum AppEmailStatus {
  SENDING
  UNKNOWN
  SENT
  FAILED
}

// Historial de la aplicación nativa de correo. La primera versión cubre salida
// SMTP; bandejas Gmail/Outlook se incorporarán como integraciones posteriores.
model AppEmailMessage {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  sentById  String         @map("sent_by_id")
  recipient String
  subject   String
  bodyText  String         @map("body_text") @db.Text
  status    AppEmailStatus @default(SENDING)
  error     String?        @db.Text
  sentAt    DateTime?      @map("sent_at")
  createdAt DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sentBy User   @relation("AppEmailSender", fields: [sentById], references: [id])

  @@index([tenantId, createdAt])
  @@index([sentById])
  @@map("app_email_messages")
}

// Copia local de los mensajes recibidos por IMAP. El UID es único solamente
// dentro de cada buzón, por eso forma parte de la clave compuesta.
model AppEmailInboxMessage {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  mailbox     String
  uidValidity String   @map("uid_validity")
  uid         String
  messageId   String?  @map("message_id")
  senderName  String?  @map("sender_name")
  senderEmail String   @map("sender_email")
  recipients  String
  subject     String
  bodyText    String   @map("body_text") @db.Text
  receivedAt  DateTime @map("received_at")
  isRead      Boolean  @default(false) @map("is_read")
  starred     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, mailbox, uidValidity, uid], map: "app_email_inbox_epoch_uid_key")
  @@index([tenantId, receivedAt])
  @@map("app_email_inbox_messages")
}

// Eventos críticos entre módulos (sale.order.completed, invoice.issued, …)
// guardados en la misma transacción que el cambio que los origina y
// despachados después, con reintentos: si un listener falla, el efecto
// (factura, cuenta por cobrar, préstamo) no se pierde.
model OutboxEvent {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  eventName     String       @map("event_name")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")

  deliveries OutboxDelivery[]

  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@map("outbox_events")
}

// Resultado de cada consumidor de un evento del outbox: un reintento solo
// vuelve a llamar a los que fallaron.
model OutboxDelivery {
  tenantId    String         @map("tenant_id")
  id          String         @id @default(uuid())
  eventId     String         @map("event_id")
  consumer    String
  status      DeliveryStatus
  attempts    Int            @default(1)
  lastError   String?        @map("last_error")
  processedAt DateTime?      @map("processed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumer])
  @@index([tenantId])
  @@map("outbox_deliveries")
}

enum DeliveryStatus {
  DONE
  FAILED
}

// Lo que salió por el remitente de la plataforma: los correos propios de
// JoapyCore (sin empresa) y los de las empresas que todavía no conectaron su
// correo. Sirve de constancia y para el tope diario por empresa. No guarda el
// cuerpo ni los adjuntos.
model PlatformEmailMessage {
  id                String   @id @default(uuid())
  tenantId          String?  @map("tenant_id")
  purpose           String
  recipient         String
  subject           String
  fromAddress       String   @map("from_address")
  replyTo           String?  @map("reply_to")
  // SENT | FAILED | UNKNOWN (no se supo si el proveedor lo aceptó)
  status            String
  providerMessageId String?  @map("provider_message_id")
  errorCode         String?  @map("error_code")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("platform_email_messages")
}

// Communications v1: tenant-scoped projections and durable delivery intent.
// Business references remain scalar across module boundaries, as in OutboxEvent.
enum CommunicationMessageStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

model ChatConversation {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  // DIRECT: dos personas, una sola por par. GROUP: con nombre.
  kind          String    @default("DIRECT")
  name          String?
  // Los dos usuarios de una conversación directa, ordenados: impide duplicarla.
  directKey     String?   @map("direct_key")
  createdBy     String    @map("created_by")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, directKey])
  @@index([tenantId, lastMessageAt])
  @@map("chat_conversations")
}

model ChatParticipant {
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  tenantId       String    @map("tenant_id")
  lastReadAt     DateTime? @map("last_read_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  @@id([conversationId, userId])
  @@index([tenantId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, conversationId, createdAt])
  @@map("chat_messages")
}

// Privadas de cada usuario: nadie más de la empresa las ve.
model UserNote {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  title     String
  body      String    @default("") @db.Text
  priority  String    @default("MEDIUM")
  starred   Boolean   @default(false)
  trashedAt DateTime? @map("trashed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, userId, updatedAt])
  @@map("user_notes")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  createdBy   String   @map("created_by")
  title       String
  description String?  @db.Text
  location    String?
  // Con allDay, las dos fechas son días de calendario guardados a medianoche UTC.
  allDay      Boolean  @default(false) @map("all_day")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  // Lo ve toda la empresa; si no, solo quien lo creó.
  companyWide Boolean  @default(false) @map("company_wide")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, startsAt])
  @@index([tenantId, createdBy, startsAt])
  @@map("calendar_events")
}

model CommunicationSettings {
  tenantId            String   @id @map("tenant_id")
  enabled             Boolean  @default(false)
  emailEnabled        Boolean  @default(false) @map("email_enabled")
  invoiceEmailEnabled Boolean  @default(false) @map("invoice_email_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("communication_settings")
}

model CommunicationIdentity {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  type            String   @default("SYSTEM")
  name            String?
  fromEmail       String   @map("from_email")
  fromName        String?  @map("from_name")
  replyTo         String?  @map("reply_to")
  outboundEnabled Boolean  @default(false) @map("outbound_enabled")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, fromEmail])
  @@index([tenantId, isDefault])
  @@map("communication_identities")
}

model CommunicationTemplateVersion {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  version   Int
  subject   String
  bodyText  String   @map("body_text") @db.Text
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code, version])
  @@map("communication_template_versions")
}

model CommunicationMessage {
  id                String                     @id @default(uuid())
  tenantId          String                     @map("tenant_id")
  entityType        String                     @default("INVOICE") @map("entity_type")
  entityId          String                     @map("entity_id")
  invoiceId         String                     @map("invoice_id")
  contactType       String?                    @map("contact_type")
  contactId         String?                    @map("contact_id")
  recipient         String
  pdfFileId         String                     @map("pdf_file_id")
  identityId        String?                    @map("identity_id")
  templateVersionId String                     @map("template_version_id")
  subject           String
  bodyText          String                     @map("body_text") @db.Text
  fromEmail         String                     @map("from_email")
  fromName          String?                    @map("from_name")
  replyTo           String?                    @map("reply_to")
  status            CommunicationMessageStatus @default(QUEUED)
  idempotencyKey    String                     @map("idempotency_key")
  requestedBy       String?                    @map("requested_by")
  attempts          Int                        @default(0)
  availableAt       DateTime                   @default(now()) @map("available_at")
  lockedAt          DateTime?                  @map("locked_at")
  sentAt            DateTime?                  @map("sent_at")
  lastError         String?                    @map("last_error")
  providerMessageId String?                    @map("provider_message_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, contactType, contactId, createdAt])
  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@map("communication_messages")
}

model CommunicationDeliveryAttempt {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  messageId    String    @map("message_id")
  attempt      Int
  status       String
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@unique([tenantId, messageId, attempt])
  @@map("communication_delivery_attempts")
}

model CommunicationNote {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  contactType String?  @map("contact_type")
  contactId   String?  @map("contact_id")
  body        String   @db.Text
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, contactType, contactId, createdAt])
  @@map("communication_notes")
}

model CommunicationNotification {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String    @map("user_id")
  messageId      String?   @map("message_id")
  title          String
  body           String?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  idempotencyKey String    @map("idempotency_key")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, readAt, createdAt])
  @@map("communication_notifications")
}
