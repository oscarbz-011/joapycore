// Cómo se entrega una venta lista para entregar.
enum DeliveryMethod {
  HOME_DELIVERY // La empresa la lleva a la dirección del cliente (repartidor o courier)
  PICKUP // El cliente la retira en la sucursal
  SELLER // Caso excepcional: el vendedor la lleva en persona, con autorización
}

// Pedido del vendedor para llevar el pedido en persona.
enum SellerDeliveryRequestStatus {
  PENDING // Espera la decisión de un supervisor
  AUTHORIZED
  REJECTED
}

// Una ruta se arma (OPEN), el repartidor la inicia (IN_PROGRESS) y se cierra
// sola cuando todas sus paradas quedaron resueltas (COMPLETED).
enum DeliveryRouteStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryRouteEventType {
  CREATED
  STOP_ADDED
  STOP_REMOVED
  REORDERED
  DRIVER_CHANGED
  DATE_CHANGED
  STARTED
  STOP_DELIVERED
  STOP_FAILED
  COMPLETED
  CANCELLED
  // Un hito marcado para toda la ruta de una vez.
  CHECKPOINT
}

enum DeliveryNoteStatus {
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Empleado interno; repartidor externo ocasional con usuario propio en el
// sistema (mismo flujo de tracking que un empleado); empresa de courier
// externa — sin tracking ni confirmación de ubicación posible, el staff
// marca "entregado" manualmente una vez que el courier confirma por fuera.
enum DeliveryAssignmentMode {
  INTERNAL_EMPLOYEE
  EXTERNAL_COURIER_USER
  EXTERNAL_COMPANY
}

// MANUAL = hito cargado a mano por el repartidor; GPS_AUTO = ping automático
// futuro (no implementado todavía) — mismo modelo, deja la puerta abierta a
// migrar a GPS en vivo sin cambiar el schema.
enum DeliveryEventSource {
  MANUAL
  GPS_AUTO
}

enum DeliveryCheckpoint {
  LEFT_WAREHOUSE
  IN_TRANSIT
  ARRIVED
  DELIVERED
}

model DeliveryNote {
  id                  String                       @id @default(uuid())
  tenantId            String                       @map("tenant_id")
  saleOrderId         String                       @unique @map("sale_order_id")
  noteNumber          String?                      @map("note_number")
  carrier             String?
  vehicle             String?
  status              DeliveryNoteStatus           @default(PENDING)
  assignmentMode      DeliveryAssignmentMode?      @map("assignment_mode")
  assignedEmployeeId  String?                      @map("assigned_employee_id")
  externalTrackingRef String?                      @map("external_tracking_ref")
  method              DeliveryMethod               @default(HOME_DELIVERY)
  // Retiro en sucursal: quién se llevó el pedido.
  pickedUpByName      String?                      @map("picked_up_by_name")
  pickedUpByDocument  String?                      @map("picked_up_by_document")
  // Entrega a cargo del vendedor: quién la pidió y quién la decidió.
  sellerRequestStatus SellerDeliveryRequestStatus? @map("seller_request_status")
  sellerRequestNote   String?                      @map("seller_request_note")
  sellerRequestedById String?                      @map("seller_requested_by_id")
  sellerRequestedAt   DateTime?                    @map("seller_requested_at")
  sellerDecidedById   String?                      @map("seller_decided_by_id")
  sellerDecidedAt     DateTime?                    @map("seller_decided_at")
  sellerDecisionNote  String?                      @map("seller_decision_note")
  // En qué ruta de reparto va y en qué lugar del recorrido.
  routeId             String?                      @map("route_id")
  routeOrder          Int?                         @map("route_order")
  issuedAt            DateTime?                    @map("issued_at")
  deliveredAt         DateTime?                    @map("delivered_at")
  notes               String?
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  saleOrder         SaleOrder               @relation(fields: [saleOrderId], references: [id])
  assignedEmployee  Employee?               @relation(fields: [assignedEmployeeId], references: [id])
  sellerRequestedBy User?                   @relation("DeliverySellerRequester", fields: [sellerRequestedById], references: [id])
  sellerDecidedBy   User?                   @relation("DeliverySellerDecider", fields: [sellerDecidedById], references: [id])
  route             DeliveryRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  trackingEvents    DeliveryTrackingEvent[]
  routeEvents       DeliveryRouteEvent[]

  @@index([tenantId, status])
  @@index([routeId])
  @@map("delivery_notes")
}

// Una salida de reparto: un repartidor, un día y sus paradas en orden. Nace
// sola cuando se le asigna la primera entrega del día al repartidor.
model DeliveryRoute {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  // RUT-26-000001: correlativo por empresa, como el código de cliente.
  code             String
  routeDate        DateTime            @map("route_date") @db.Date
  status           DeliveryRouteStatus @default(OPEN)
  driverEmployeeId String?             @map("driver_employee_id")
  vehicle          String?
  notes            String?
  startedAt        DateTime?           @map("started_at")
  finishedAt       DateTime?           @map("finished_at")
  createdById      String?             @map("created_by_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  driver     Employee?            @relation(fields: [driverEmployeeId], references: [id], onDelete: SetNull)
  createdBy  User?                @relation("DeliveryRouteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries DeliveryNote[]
  events     DeliveryRouteEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, routeDate])
  @@index([tenantId, status])
  @@index([tenantId, driverEmployeeId, status])
  @@map("delivery_routes")
}

// Historial de la ruta. `detail` guarda el dato legible (el cliente de la
// parada, el repartidor anterior) porque una entrega que sale de la ruta deja
// de estar vinculada a ella.
model DeliveryRouteEvent {
  id             String                 @id @default(uuid())
  tenantId       String                 @map("tenant_id")
  routeId        String                 @map("route_id")
  type           DeliveryRouteEventType
  deliveryNoteId String?                @map("delivery_note_id")
  detail         String?
  reason         String?
  latitude       Decimal?               @db.Decimal(9, 6)
  longitude      Decimal?               @db.Decimal(9, 6)
  userId         String?                @map("user_id")
  createdAt      DateTime               @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  route        DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deliveryNote DeliveryNote? @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)
  user         User?         @relation("DeliveryRouteEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, routeId, createdAt])
  @@map("delivery_route_events")
}

// Checkpoints manuales del recorrido (salió del depósito → en camino →
// llegó → entregado), cada uno con coordenada opcional. `source` deja la
// puerta abierta a GPS en vivo más adelante sin migración nueva: un ping
// automático futuro solo inserta más filas con source=GPS_AUTO,
// checkpoint=null, más seguido — misma tabla.
model DeliveryTrackingEvent {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  deliveryNoteId    String              @map("delivery_note_id")
  source            DeliveryEventSource @default(MANUAL)
  checkpoint        DeliveryCheckpoint?
  latitude          Decimal?            @db.Decimal(9, 6)
  longitude         Decimal?            @db.Decimal(9, 6)
  locationConfirmed Boolean?            @map("location_confirmed")
  notes             String?
  recordedById      String?             @map("recorded_by_id")
  recordedAt        DateTime            @default(now()) @map("recorded_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id])

  @@index([tenantId, deliveryNoteId, recordedAt])
  @@index([deliveryNoteId])
  @@map("delivery_tracking_events")
}
