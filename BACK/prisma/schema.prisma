generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum EmployeeCount {
  RANGE_1_5    @map("1-5")
  RANGE_6_20   @map("6-20")
  RANGE_21_50  @map("21-50")
  RANGE_51_200 @map("51-200")
  RANGE_201    @map("201+")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RESERVED
}

enum MovementReason {
  PURCHASE
  CUSTOMER_RETURN
  ADJUSTMENT
  TRANSFER
  INITIAL
  SALE_OUT
  SALE_REVERSAL
  // Producción: la materia prima sale (PRODUCTION_OUT) y el producto
  // fabricado entra (PRODUCTION_IN) al completarse una orden. Ver
  // ProductionOrder / InventoryOnProductionListener.
  PRODUCTION_IN
  PRODUCTION_OUT
}

// Origen documentado de una carga inicial de stock (reason=INITIAL) — no
// finge ser una compra real, solo deja registrado de dónde vino.
enum StockInitialSourceType {
  PURCHASE
  MIGRATION
  PRODUCTION
  DONATION
  OTHER
}

enum AlertType {
  STOCK_LOW
  PAYMENT_DUE
  INVOICE_OVERDUE
}

enum AlertChannel {
  EMAIL
  SYSTEM
}

enum PurchaseType {
  LOCAL
  IMPORT
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleOrderStatus {
  QUOTED
  PENDING
  PENDING_CREDIT_APPROVAL
  CREDIT_APPROVED
  CREDIT_REJECTED
  CREDIT_NEEDS_ADJUSTMENT
  PAYMENT_RECEIVED
  CONFIRMED
  DELIVERED
  INVOICED
  CANCELLED
}

enum CreditAdjustmentSuggestion {
  LOWER_VALUE_PRODUCT
  MORE_INSTALLMENTS
  ADD_GUARANTOR
}

enum CreditBureauCheckFrequency {
  FIRST_PURCHASE_ONLY
  EVERY_REQUEST
}

enum CreditBureauCheckResult {
  CLEAN
  FLAGGED
}

enum DeliveryNoteStatus {
  PENDING
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Empleado interno; repartidor externo ocasional con usuario propio en el
// sistema (mismo flujo de tracking que un empleado); empresa de courier
// externa — sin tracking ni confirmación de ubicación posible, el staff
// marca "entregado" manualmente una vez que el courier confirma por fuera.
enum DeliveryAssignmentMode {
  INTERNAL_EMPLOYEE
  EXTERNAL_COURIER_USER
  EXTERNAL_COMPANY
}

// MANUAL = hito cargado a mano por el repartidor; GPS_AUTO = ping automático
// futuro (no implementado todavía) — mismo modelo, deja la puerta abierta a
// migrar a GPS en vivo sin cambiar el schema.
enum DeliveryEventSource {
  MANUAL
  GPS_AUTO
}

enum DeliveryCheckpoint {
  LEFT_WAREHOUSE
  IN_TRANSIT
  ARRIVED
  DELIVERED
}

enum MarkupType {
  PERCENTAGE
  FIXED
}

// Estado de la FICHA del producto — no del stock. El stock vive en
// StockMovement (IN/OUT/ADJUSTMENT/TRANSFER/RESERVED), que es historial de
// movimientos, no un campo acá. Un producto puede existir en el catálogo sin
// precio ni existencias (DRAFT) sin frenar la carga de catálogo; recién al
// pasarlo a ACTIVE se exige lo mínimo para operar (ver
// ProductsService.assertActivatable).
enum ProductStatus {
  DRAFT // creado pero incompleto — no vendible ni comprable
  ACTIVE // completo, habilitado para comprar y vender
  INACTIVE // descontinuado — sobrevive en el historial de ventas pasadas
  BLOCKED // completo pero restringido (problema de calidad, auditoría pendiente)
}

// De dónde sale el stock de este producto. El proyecto es multi-rubro y el
// inventario no se maneja igual en todos: una ferretería o una tienda de
// electrodomésticos compra terminado para revender, una carpintería fabrica lo
// que vende y solo compra materia prima e insumos. La clasificación es POR
// PRODUCTO, no por rubro — una mueblería también revende colchones, y el rubro
// del tenant solo define el default al crear (ver INDUSTRY_DEFAULT_KIND).
enum ProductKind {
  RESALE // se compra terminado y se vende tal cual
  RAW_MATERIAL // se compra para consumir en producción (madera, tornillos, cola)
  MANUFACTURED // se produce internamente a partir de una receta y se vende
}

// Rubro del tenant. Era texto libre y solo servía para sembrar categorías por
// defecto; un typo en el registro dejaba al tenant sin defaults en silencio.
// Como ahora también decide el ProductKind por defecto, pasó a lista cerrada.
enum Industry {
  ELECTRODOMESTICOS
  FERRETERIA
  SUPERMERCADO
  MUEBLERIA
  SERVICIOS
  OTRO
}

enum ProductionOrderStatus {
  DRAFT // se puede editar cantidad y consumos
  IN_PROGRESS // materia prima ya reservada/en uso, la orden está en el taller
  COMPLETED // se fabricó: salió la materia prima y entró el producto terminado
  CANCELLED
}

enum SaleType {
  CASH
  CREDIT
}

enum OrderType {
  STANDARD
  QUOTE
  WHOLESALE
}

enum ComboPriceMode {
  FIXED
  SUM_WITH_DISCOUNT
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum MarkupMethod {
  PERCENTAGE
  FIXED
}

enum InvoiceStatus {
  PENDING
  ISSUED
  PAID
  CANCELLED
}

// SALE = factura de venta normal (flujo de siempre). INTEREST = factura
// generada automáticamente por los intereses moratorios cobrados en un pago
// de cuota — sin saleOrderId (ver Invoice.saleOrderId), referenciada por
// paymentReceiptId en su lugar.
enum InvoiceType {
  SALE
  INTEREST
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
}

enum ARStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum APStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum DocumentType {
  CI
  RUC
  PASSPORT
}

enum Gender {
  MASCULINO
  FEMENINO
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum ContractType {
  PERMANENT
  TEMPORARY
  PART_TIME
  CONTRACTOR
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  PAGO_EXPRESS
  AQUI_PAGO
  CHECK
}

enum EconomicActivity {
  ASALARIADO
  FUNCIONARIO_PUBLICO
  PROFESIONAL_INDEPENDIENTE
  COMERCIANTE
}

enum AdvancePaymentMode {
  REDUCE_INSTALLMENTS
  REDUCE_AMOUNT
}

enum LeaveType {
  VACATION
  SICK
  MATERNITY
  PATERNITY
  PERSONAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  PENDING
  PROCESSED
  PAID
}

enum CollectionRouteStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum VisitResult {
  COLLECTED
  PARTIAL
  ABSENT
  REFUSED
  PROMISE
}

enum AgreementStatus {
  ACTIVE
  FULFILLED
  BROKEN
  CANCELLED
}

enum CollectionNoteType {
  VISIT
  CALL
  MESSAGE
  GENERAL
}

enum SifenEnvironment {
  TESTING
  PRODUCTION
}

enum OrderChannel {
  NORMAL
  POS
  ECOMMERCE
}

enum PosSessionStatus {
  OPEN
  CLOSED
  DISCREPANCY
}

// ─── Core ─────────────────────────────────────────────────────────────────────

model Tenant {
  id       String       @id @default(uuid())
  name     String
  industry Industry?
  plan     String       @default("trial")
  status   TenantStatus @default(ACTIVE)

  // Company profile
  razonSocial    String?        @map("razon_social")
  nombreFantasia String?        @map("nombre_fantasia")
  ruc            String?
  address        String?
  numeroCasa     String?        @map("numero_casa")
  postalCode     String?        @map("postal_code")
  city           String?
  department     String?
  country        String         @default("Paraguay")
  phone          String?
  email          String?
  logoFileId     String?        @unique @map("logo_file_id")
  employeeCount  EmployeeCount? @map("employee_count")
  currency       String         @default("PYG")

  // SIFEN — datos fiscales
  timbradoNumero        String?   @map("timbrado_numero")
  timbradoFecha         DateTime? @map("timbrado_fecha")
  timbradoFechaFin      DateTime? @map("timbrado_fecha_fin")
  tipoContribuyente     Int?      @map("tipo_contribuyente") // 1=Física 2=Jurídica
  tipoRegimen           Int?      @map("tipo_regimen") // 8=IVA General, etc.
  actividadesEconomicas Json?     @map("actividades_economicas") // [{codigo, descripcion}]

  // SIFEN — dirección estructurada (códigos SET)
  departamentoCodigo Int?    @map("departamento_codigo")
  departamentoDesc   String? @map("departamento_desc")
  distritoCodigo     Int?    @map("distrito_codigo")
  distritoDesc       String? @map("distrito_desc")
  ciudadCodigo       Int?    @map("ciudad_codigo")
  ciudadDesc         String? @map("ciudad_desc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logoFile               FileRecord?             @relation("TenantLogo", fields: [logoFileId], references: [id])
  users                  User[]
  roles                  Role[]
  tenantModules          TenantModule[]
  creditNotes            CreditNote[]
  branches               Branch[]
  warehouses             Warehouse[]
  loans                  Loan[]
  installments           Installment[]
  categories             Category[]
  brands                 Brand[]
  products               Product[]
  productSuppliers       ProductSupplier[]
  productUnits           ProductUnit[]
  productBatches         ProductBatch[]
  productComponents      ProductComponent[]
  productionOrders       ProductionOrder[]
  supplierCatalogItems   SupplierCatalogItem[]
  stockMovements         StockMovement[]
  posTerminals           PosTerminal[]
  posSessions            PosSession[]
  customers              Customer[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  saleOrders             SaleOrder[]
  invoices               Invoice[]
  accountsReceivable     AccountsReceivable[]
  paymentRecords         PaymentRecord[]
  accountsPayable        AccountsPayable[]
  supplierPayments       SupplierPayment[]
  areas                  Area[]
  positions              Position[]
  employees              Employee[]
  payrollConfig          PayrollConfig?
  payrollRecords         PayrollRecord[]
  auditLogs              AuditLog[]
  alertConfigs           AlertConfig[]
  fileRecords            FileRecord[]
  documents              Document[]
  documentCategories     DocumentCategory[]
  creditConfig           CreditConfig?
  pricingConfig          PricingConfig?
  salesConfig            SalesConfig?
  saleCombos             SaleCombo[]
  saleTargets            SaleTarget[]
  downPayments           DownPayment[]
  salePayments           SalePayment[]
  deliveryNotes          DeliveryNote[]
  deliveryTrackingEvents DeliveryTrackingEvent[]
  collectionRoutes       CollectionRoute[]
  collectionVisits       CollectionVisit[]
  paymentAgreements      PaymentAgreement[]
  collectionNotes        CollectionNote[]
  sifenConfig            SifenConfig?
  guarantors             Guarantor[]
  creditBureauConfig     CreditBureauConfig?
  creditBureauChecks     CreditBureauCheck[]
  paymentReceipts        PaymentReceipt[]
  interestComponents     InterestComponent[]
  delinquencyReports     DelinquencyReport[]

  @@map("tenants")
}

model SifenConfig {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  environment SifenEnvironment @default(TESTING)

  // Certificado de firma (.p12 / .pfx) — almacenado cifrado con AES-256-GCM
  certFilename   String?   @map("cert_filename")
  certData       Bytes?    @map("cert_data")
  certPassword   String?   @map("cert_password") // cifrado
  certType       String?   @map("cert_type") // p12 | pfx | cer | crt
  certValidFrom  DateTime? @map("cert_valid_from")
  certValidUntil DateTime? @map("cert_valid_until")
  certSubject    String?   @map("cert_subject")

  // Certificado CA raíz SET Paraguay (opcional, .cer / .crt)
  caCertFilename String? @map("ca_cert_filename")
  caCertData     Bytes?  @map("ca_cert_data")

  isConfigured Boolean   @default(false) @map("is_configured")
  lastTestedAt DateTime? @map("last_tested_at")
  lastTestOk   Boolean?  @map("last_test_ok")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sifen_configs")
}

model Branch {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  name       String
  address    String?
  numeroCasa String? @map("numero_casa")
  city       String?
  phone      String?
  email      String?
  isMain     Boolean @default(false) @map("is_main")
  isActive   Boolean @default(true) @map("is_active")

  // SIFEN — datos de establecimiento
  codigoEstablecimiento String? @map("codigo_establecimiento") // "001" registro ante SET
  puntoExpedicion       String? @default("001") @map("punto_expedicion") // "001" punto de expedición
  departamentoCodigo    Int?    @map("departamento_codigo")
  departamentoDesc      String? @map("departamento_desc")
  distritoCodigo        Int?    @map("distrito_codigo")
  distritoDesc          String? @map("distrito_desc")
  ciudadCodigo          Int?    @map("ciudad_codigo")
  ciudadDesc            String? @map("ciudad_desc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouses      Warehouse[]
  users           User[]
  stockMovements  StockMovement[]
  saleOrders      SaleOrder[]
  purchaseOrders  PurchaseOrder[]
  employees       Employee[]
  posTerminals    PosTerminal[]
  paymentReceipts PaymentReceipt[]

  @@unique([tenantId, name])
  @@map("branches")
}

model Warehouse {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  name      String
  address   String?
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  stockMovements   StockMovement[]
  saleOrderItems   SaleOrderItem[]
  purchaseReceipts PurchaseReceipt[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, name])
  @@map("warehouses")
}

model TenantModule {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  moduleName  String    @map("module_name")
  active      Boolean   @default(false)
  activatedAt DateTime? @map("activated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleName])
  @@map("tenant_modules")
}

model User {
  id                    String     @id @default(uuid())
  tenantId              String     @map("tenant_id")
  branchId              String?    @map("branch_id")
  email                 String     @unique
  username              String?    @unique
  passwordHash          String     @map("password_hash")
  firstName             String     @map("first_name")
  lastName              String     @map("last_name")
  phone                 String?    @map("phone")
  status                UserStatus @default(ACTIVE)
  mustChangePassword    Boolean    @default(false) @map("must_change_password")
  tempPasswordEncrypted String?    @map("temp_password_encrypted")
  tempPasswordExpiresAt DateTime?  @map("temp_password_expires_at")
  lastLoginAt           DateTime?  @map("last_login_at")
  // Tokens (access y refresh) emitidos antes de este momento dejan de valer:
  // se actualiza al cambiar/resetear la contraseña o desactivar el usuario.
  sessionsValidAfter    DateTime?  @map("sessions_valid_after")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  deletedAt             DateTime?  @map("deleted_at")

  tenant                         Tenant                  @relation(fields: [tenantId], references: [id])
  branch                         Branch?                 @relation(fields: [branchId], references: [id])
  userRoles                      UserRole[]
  userPermissions                UserPermission[]
  refreshTokens                  RefreshToken[]
  employee                       Employee?
  auditLogs                      AuditLog[]
  createdSaleOrders              SaleOrder[]             @relation("SaleCreator")
  selledSaleOrders               SaleOrder[]             @relation("SaleSeller")
  approvedSaleOrders             SaleOrder[]             @relation("CreditApprover")
  rejectedSaleOrders             SaleOrder[]             @relation("CreditRejecter")
  registeredDownPayments         DownPayment[]           @relation("DownPaymentRegistrar")
  collectedSalePayments          SalePayment[]           @relation("SalePaymentCollector")
  saleTargets                    SaleTarget[]
  collectionRoutesAsCollector    CollectionRoute[]       @relation("RouteCollector")
  closedCollectionRoutes         CollectionRoute[]       @relation("RouteClosedBy")
  createdCollectionRoutes        CollectionRoute[]       @relation("RouteCreatedBy")
  approvedAgreements             PaymentAgreement[]      @relation("AgreementApprovedBy")
  createdAgreements              PaymentAgreement[]      @relation("AgreementCreatedBy")
  createdCollectionNotes         CollectionNote[]        @relation("NoteCreatedBy")
  posSessionsAsCashier           PosSession[]            @relation("SessionCashier")
  collectedPaymentReceipts       PaymentReceipt[]
  createdPurchaseReceipts        PurchaseReceipt[]
  createdProductionOrders        ProductionOrder[]
  recordedDeliveryTrackingEvents DeliveryTrackingEvent[]
  createdSupplierPayments        SupplierPayment[]
  reviewedDelinquencyReports     DelinquencyReport[]     @relation("DelinquencyReportReviewedBy")

  @@map("users")
}

model UserPermission {
  userId       String @map("user_id")
  permissionId String @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isSystem Boolean @default(false) @map("is_system")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  positions       Position[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Brand {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Product {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  categoryId           String?     @map("category_id")
  brandId              String?     @map("brand_id")
  model                String?
  name                 String
  description          String?
  isSerialized         Boolean     @default(false) @map("is_serialized")
  usesLots             Boolean     @default(false) @map("uses_lots")
  // Naturaleza del producto — ver enum ProductKind. Define de dónde entra su
  // stock (compra vs. producción) y de qué default parten los dos flags de
  // abajo.
  kind                 ProductKind @default(RESALE)
  // En qué flujos participa. Se derivan de `kind` al crear pero quedan
  // editables a propósito: el mismo tornillo puede ser materia prima de un
  // mueble Y venderse suelto en el mostrador, y eso no es un caso raro en una
  // ferretería/carpintería. Las reglas de Compras y Ventas miran estos flags,
  // no el `kind`, justamente para no romperse en esos casos mixtos.
  isPurchasable        Boolean     @default(true) @map("is_purchasable")
  isSellable           Boolean     @default(true) @map("is_sellable")
  unit                 String      @default("unidad")
  weightKg             Float?      @map("weight_kg")
  heightCm             Float?      @map("height_cm")
  widthCm              Float?      @map("width_cm")
  depthCm              Float?      @map("depth_cm")
  // Nullable a propósito: un producto en DRAFT puede no tener precio todavía
  // (catálogo cargado antes de negociar con el proveedor). null = "pendiente",
  // que NO es lo mismo que 0 — un 0 explícito es un precio real de cero.
  costPrice            Decimal?    @map("cost_price") @db.Decimal(12, 2)
  salePrice            Decimal?    @map("sale_price") @db.Decimal(12, 2)
  additionalMarkup     Decimal?    @map("additional_markup") @db.Decimal(8, 2)
  additionalMarkupType MarkupType? @map("additional_markup_type")
  stockMin             Int         @default(0) @map("stock_min")
  stockInitial         Int         @default(0) @map("stock_initial")
  ivaTaxRate           Decimal     @default(10) @map("iva_tax_rate") @db.Decimal(5, 2)
  ivaIncluded          Boolean     @default(false) @map("iva_included")
  status               ProductStatus @default(DRAFT)
  deletedAt            DateTime?   @map("deleted_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  brand                Brand?                @relation(fields: [brandId], references: [id])
  units                ProductUnit[]
  productBatches       ProductBatch[]
  stockMovements       StockMovement[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  saleOrderItems       SaleOrderItem[]
  productSuppliers     ProductSupplier[]
  comboItems           SaleComboItem[]
  // De qué está hecho este producto (si es MANUFACTURED)…
  recipe               ProductComponent[] @relation("ProductRecipe")
  // …y en la receta de qué otros productos aparece (si es materia prima).
  usedIn               ProductComponent[] @relation("ProductComponentOf")
  productionOrders     ProductionOrder[]
  productionConsumed   ProductionOrderItem[]
  supplierCatalogItems SupplierCatalogItem[]

  @@map("products")
}

// Receta / lista de materiales de un producto MANUFACTURED: de qué está hecho
// y cuánto lleva de cada cosa. Es un árbol de un solo nivel a propósito — una
// carpintería arma "mesa = 3 tableros + 12 tornillos + 1 cola", no necesita
// sub-ensambles anidados para el MVP. Se valida en el servicio que un producto
// no sea componente de sí mismo (ni en cadena) para no crear ciclos.
model ProductComponent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  // El producto que se fabrica.
  productId String   @map("product_id")
  // El insumo que se consume (materia prima, o incluso otro producto).
  componentId String @map("component_id")
  // Cuánto se consume por unidad producida. Decimal porque una receta puede
  // llevar 0,5 litros de barniz o 2,25 metros de tela.
  quantity  Decimal  @db.Decimal(12, 3)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  product   Product @relation("ProductRecipe", fields: [productId], references: [id])
  component Product @relation("ProductComponentOf", fields: [componentId], references: [id])

  @@unique([productId, componentId])
  @@index([tenantId, productId])
  @@map("product_components")
}

// Orden de producción: fabricar N unidades de un producto MANUFACTURED
// consumiendo su receta. Al completarse genera los movimientos de stock (OUT
// por cada componente, IN por el producto terminado) — nunca se toca el stock
// directo, igual que en compras y ventas.
model ProductionOrder {
  id          String                @id @default(uuid())
  tenantId    String                @map("tenant_id")
  orderNumber Int                   @map("order_number")
  productId   String                @map("product_id")
  quantity    Decimal               @db.Decimal(12, 3)
  status      ProductionOrderStatus @default(DRAFT)
  // Depósito del que sale la materia prima y al que entra lo fabricado.
  warehouseId String?               @map("warehouse_id")
  startedAt   DateTime?             @map("started_at")
  completedAt DateTime?             @map("completed_at")
  notes       String?
  createdById String?               @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  product   Product               @relation(fields: [productId], references: [id])
  warehouse Warehouse?            @relation(fields: [warehouseId], references: [id])
  createdBy User?                 @relation(fields: [createdById], references: [id])
  items     ProductionOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@map("production_orders")
}

// Consumo planificado vs. real de cada componente. Se copia de la receta al
// crear la orden (snapshot: si la receta cambia después, la orden vieja sigue
// mostrando lo que realmente se planificó) y el consumo real se ajusta al
// completar, porque en el taller casi nunca sale exacto.
model ProductionOrderItem {
  id                String  @id @default(uuid())
  productionOrderId String  @map("production_order_id")
  componentId       String  @map("component_id")
  plannedQuantity   Decimal @map("planned_quantity") @db.Decimal(12, 3)
  usedQuantity      Decimal @default(0) @map("used_quantity") @db.Decimal(12, 3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  component       Product         @relation(fields: [componentId], references: [id])

  @@unique([productionOrderId, componentId])
  @@map("production_order_items")
}

// Catálogo tal como lo manda el proveedor, ANTES de mapearlo al catálogo
// interno. Es una tabla aparte de ProductSupplier a propósito: aquella exige
// `productId` y es única por par producto-proveedor, así que no puede
// representar un ítem todavía sin mapear — y ese es justamente el punto de
// importar la lista de precios sin tener que crear productos primero.
// Ver plan-modulo-compras.md, Fase 1.
model SupplierCatalogItem {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  supplierId  String  @map("supplier_id")
  // Código con el que el proveedor identifica el ítem — es la clave natural
  // de la importación (upsert por proveedor + código).
  supplierSku String  @map("supplier_sku")
  description String
  price       Decimal? @db.Decimal(12, 2)
  // Unidad en la que vende el proveedor y cuántas unidades internas equivale
  // (ej. vende "caja x12" y el factor 12 lo lleva a unidades).
  supplierUnit     String?  @map("supplier_unit")
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(12, 4)
  validFrom        DateTime? @map("valid_from")
  validTo          DateTime? @map("valid_to")
  // Nullable a propósito: el ítem vive suelto hasta que alguien lo vincula a
  // un producto interno (o hasta que la orden de compra lo fuerza).
  productId   String?  @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@unique([supplierId, supplierSku])
  @@index([tenantId, supplierId])
  @@map("supplier_catalog_items")
}

model ProductSupplier {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  supplierId  String   @map("supplier_id")
  costPrice   Decimal? @map("cost_price") @db.Decimal(12, 2)
  isPreferred Boolean  @default(false) @map("is_preferred")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model ProductUnit {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  productId             String            @map("product_id")
  serialNumber          String            @map("serial_number")
  status                ProductUnitStatus @default(IN_STOCK)
  purchaseOrderItemId   String?           @map("purchase_order_item_id")
  purchaseReceiptItemId String?           @map("purchase_receipt_item_id")
  saleOrderItemId       String?           @map("sale_order_item_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  product             Product              @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id])
  saleOrderItem       SaleOrderItem?       @relation(fields: [saleOrderItemId], references: [id])

  @@unique([tenantId, productId, serialNumber])
  @@map("product_units")
}

model ProductBatch {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  productId           String    @map("product_id")
  batchNumber         String    @map("batch_number")
  entryDate           DateTime  @map("entry_date")
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 2)
  quantity            Int
  remainingQty        Int       @map("remaining_qty")
  purchaseOrderItemId String?   @map("purchase_order_item_id")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  saleOrderItems    SaleOrderItem[]
  stockMovements    StockMovement[]

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId, remainingQty])
  @@map("product_batches")
}

model StockMovement {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  productId         String                  @map("product_id")
  branchId          String?                 @map("branch_id")
  warehouseId       String?                 @map("warehouse_id")
  batchId           String?                 @map("batch_id")
  type              StockMovementType
  reason            MovementReason?         @map("reason")
  quantity          Int
  referenceId       String?                 @map("reference_id")
  initialSourceType StockInitialSourceType? @map("initial_source_type")
  notes             String?
  createdAt         DateTime                @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])
  branch    Branch?       @relation(fields: [branchId], references: [id])
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])

  @@map("stock_movements")
}

// ─── Procurement ──────────────────────────────────────────────────────────────

model Supplier {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  contactName String?   @map("contact_name")
  email       String?
  phone       String?
  address     String?
  taxId       String?   @map("tax_id")
  isImporter  Boolean   @default(false) @map("is_importer")
  // Plazo de pago en días — 0 (default) es contado. Cada AccountsPayable
  // generada al recibir mercadería de este proveedor calcula su dueDate
  // como receivedAt + paymentTermDays.
  paymentTermDays Int?  @default(0) @map("payment_term_days")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrders   PurchaseOrder[]
  productSuppliers ProductSupplier[]
  catalogItems     SupplierCatalogItem[]
  accountsPayable  AccountsPayable[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  supplierId   String              @map("supplier_id")
  branchId     String?             @map("branch_id")
  purchaseType PurchaseType        @default(LOCAL) @map("purchase_type")
  status       PurchaseOrderStatus @default(PENDING)
  orderDate    DateTime            @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  exchangeRate Decimal?            @map("exchange_rate") @db.Decimal(10, 4)
  customsDuty  Decimal?            @map("customs_duty") @db.Decimal(5, 2)
  customsRef   String?             @map("customs_ref")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  branch   Branch?             @relation(fields: [branchId], references: [id])
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  quantity        Int
  receivedQty     Int     @default(0) @map("received_qty")
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  productUnits         ProductUnit[]
  productBatches       ProductBatch[]
  purchaseReceiptItems PurchaseReceiptItem[]

  @@map("purchase_order_items")
}

// Documento de recepción propio, separado de la OC — permite recepciones
// parciales reimprimibles/listables por separado en vez de solo acumular
// PurchaseOrderItem.receivedQty como un contador sin historial propio.
model PurchaseReceipt {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  purchaseOrderId String   @map("purchase_order_id")
  receiptNumber   Int      @map("receipt_number")
  warehouseId     String?  @map("warehouse_id")
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  warehouse       Warehouse?            @relation(fields: [warehouseId], references: [id])
  createdBy       User?                 @relation(fields: [createdById], references: [id])
  items           PurchaseReceiptItem[]
  accountsPayable AccountsPayable?

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String    @id @default(uuid())
  purchaseReceiptId   String    @map("purchase_receipt_id")
  purchaseOrderItemId String    @map("purchase_order_item_id")
  productId           String    @map("product_id")
  quantity            Int
  unitCost            Decimal   @map("unit_cost") @db.Decimal(12, 2)
  batchNumber         String?   @map("batch_number")
  expiresAt           DateTime? @map("expires_at")
  // N/S ingresados en esta línea (solo productos serializados) — el listener
  // de inventory los lee de acá para crear los ProductUnit, nunca del
  // payload del evento (mismo criterio defensivo que el resto del proyecto).
  serialNumbers       String[]  @default([]) @map("serial_numbers")

  purchaseReceipt   PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  productUnits      ProductUnit[]

  @@map("purchase_receipt_items")
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model Customer {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  customerCode    String?       @map("customer_code")
  firstName       String        @map("first_name")
  secondFirstName String?       @map("second_first_name")
  lastName        String        @map("last_name")
  secondLastName  String?       @map("second_last_name")
  documentType    DocumentType? @map("document_type")
  documentNumber  String?       @map("document_number")
  email           String?
  phone           String?
  address         String?
  city            String?
  profession      String?
  monthlyIncome   Decimal?      @map("monthly_income") @db.Decimal(12, 2)
  creditLimit     Decimal?      @map("credit_limit") @db.Decimal(12, 2)
  notes           String?

  economicActivity EconomicActivity? @map("economic_activity")
  hasIpsInsurance  Boolean?          @map("has_ips_insurance")

  // Datos laborales
  employerName   String? @map("employer_name")
  supervisorName String? @map("supervisor_name")
  workPhone      String? @map("work_phone")
  workAddress    String? @map("work_address")
  workSeniority  String? @map("work_seniority")

  // Structured delivery address — Casa
  homeStreet       String? @map("home_street")
  homeNeighborhood String? @map("home_neighborhood")
  homeReference    String? @map("home_reference")

  // Structured delivery address — Departamento / Apto
  aptBuilding String? @map("apt_building")
  aptFloor    String? @map("apt_floor")
  aptNumber   String? @map("apt_number")

  // Última coordenada conocida — "mejor estimación" para el pin por defecto
  // del mapa. La fuente de verdad de qué pasó en una entrega puntual es
  // DeliveryTrackingEvent, no esto; se sincroniza acá solo cuando el
  // repartidor confirma que corrigió la ubicación.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  saleOrders        SaleOrder[]
  loans             Loan[]
  collectionVisits  CollectionVisit[]
  paymentAgreements PaymentAgreement[]
  collectionNotes   CollectionNote[]
  bureauChecks      CreditBureauCheck[]
  paymentReceipts   PaymentReceipt[]
  delinquencyReports DelinquencyReport[]

  @@unique([tenantId, customerCode])
  @@map("customers")
}

model SaleOrder {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  customerId   String          @map("customer_id")
  branchId     String?         @map("branch_id")
  createdById  String?         @map("created_by_id")
  sellerId     String?         @map("seller_id")
  status       SaleOrderStatus @default(PENDING)
  orderType    OrderType       @default(STANDARD) @map("order_type")
  saleType     SaleType        @default(CASH) @map("sale_type")
  channel      OrderChannel    @default(NORMAL) @map("channel")
  installments Int?
  interestRate Decimal?        @map("interest_rate") @db.Decimal(5, 2)
  orderDate    DateTime        @map("order_date")
  notes        String?

  // Totals (denormalized from items for reporting and POS display)
  subtotal Decimal? @map("subtotal") @db.Decimal(12, 2)
  total    Decimal? @map("total") @db.Decimal(12, 2)

  // Presupuestos (orderType=QUOTE) — código secuencial PRES-AA-NNNNNN y PDF
  // generado automáticamente al crear. Null para pedidos que no son presupuesto.
  quoteNumber    String? @map("quote_number") // único por tenant, ver @@unique abajo
  quotePdfFileId String? @map("quote_pdf_file_id")

  // POS session link (null for NORMAL channel)
  posSessionId String? @map("pos_session_id")

  // Delivery surcharge (freight / zone)
  surchargeType   MarkupType? @map("surcharge_type")
  surchargeAmount Decimal?    @map("surcharge_amount") @db.Decimal(12, 2)
  surchargeReason String?     @map("surcharge_reason")

  // Credit approval tracking
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectedById    String?   @map("rejected_by_id")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")

  // Devuelto al vendedor para ajustar (sin rechazar) — ej. sugerir bajar el
  // valor del pedido, sumar cuotas, o agregar un garante.
  adjustmentNote        String?                      @map("adjustment_note")
  suggestedAlternatives CreditAdjustmentSuggestion[] @map("suggested_alternatives")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  customer     Customer            @relation(fields: [customerId], references: [id])
  branch       Branch?             @relation(fields: [branchId], references: [id])
  createdBy    User?               @relation("SaleCreator", fields: [createdById], references: [id])
  seller       User?               @relation("SaleSeller", fields: [sellerId], references: [id])
  approvedBy   User?               @relation("CreditApprover", fields: [approvedById], references: [id])
  rejectedBy   User?               @relation("CreditRejecter", fields: [rejectedById], references: [id])
  items        SaleOrderItem[]
  invoice      Invoice?
  loan         Loan?
  downPayment  DownPayment?
  salePayments SalePayment[]
  deliveryNote DeliveryNote?
  posSession   PosSession?         @relation(fields: [posSessionId], references: [id])
  guarantors   Guarantor[]
  bureauChecks CreditBureauCheck[]

  @@unique([tenantId, quoteNumber])
  @@map("sale_orders")
}

model Guarantor {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  saleOrderId    String       @map("sale_order_id")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number")
  phone          String?
  email          String?
  monthlyIncome  Decimal?     @map("monthly_income") @db.Decimal(12, 2)
  address        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id])

  @@map("guarantors")
}

model SalePayment {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  saleOrderId   String        @map("sale_order_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @map("payment_date")
  reference     String?
  notes         String?
  collectedById String?       @map("collected_by_id")
  posSessionId  String?       @map("pos_session_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  saleOrder   SaleOrder   @relation(fields: [saleOrderId], references: [id])
  collectedBy User?       @relation("SalePaymentCollector", fields: [collectedById], references: [id])
  posSession  PosSession? @relation(fields: [posSessionId], references: [id])

  @@index([tenantId, saleOrderId])
  @@map("sale_payments")
}

model DeliveryNote {
  id                  String                  @id @default(uuid())
  tenantId            String                  @map("tenant_id")
  saleOrderId         String                  @unique @map("sale_order_id")
  noteNumber          String?                 @map("note_number")
  carrier             String?
  vehicle             String?
  status              DeliveryNoteStatus      @default(PENDING)
  assignmentMode      DeliveryAssignmentMode? @map("assignment_mode")
  assignedEmployeeId  String?                 @map("assigned_employee_id")
  externalTrackingRef String?                 @map("external_tracking_ref")
  issuedAt            DateTime?               @map("issued_at")
  deliveredAt         DateTime?               @map("delivered_at")
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  saleOrder        SaleOrder               @relation(fields: [saleOrderId], references: [id])
  assignedEmployee Employee?               @relation(fields: [assignedEmployeeId], references: [id])
  trackingEvents   DeliveryTrackingEvent[]

  @@map("delivery_notes")
}

// Checkpoints manuales del recorrido (salió del depósito → en camino →
// llegó → entregado), cada uno con coordenada opcional. `source` deja la
// puerta abierta a GPS en vivo más adelante sin migración nueva: un ping
// automático futuro solo inserta más filas con source=GPS_AUTO,
// checkpoint=null, más seguido — misma tabla.
model DeliveryTrackingEvent {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  deliveryNoteId    String              @map("delivery_note_id")
  source            DeliveryEventSource @default(MANUAL)
  checkpoint        DeliveryCheckpoint?
  latitude          Decimal?            @db.Decimal(9, 6)
  longitude         Decimal?            @db.Decimal(9, 6)
  locationConfirmed Boolean?            @map("location_confirmed")
  notes             String?
  recordedById      String?             @map("recorded_by_id")
  recordedAt        DateTime            @default(now()) @map("recorded_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id])

  @@index([tenantId, deliveryNoteId, recordedAt])
  @@map("delivery_tracking_events")
}

model DownPayment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  saleOrderId    String        @unique @map("sale_order_id")
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentDate    DateTime      @map("payment_date")
  reference      String?
  notes          String?
  registeredById String?       @map("registered_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  saleOrder    SaleOrder @relation(fields: [saleOrderId], references: [id])
  registeredBy User?     @relation("DownPaymentRegistrar", fields: [registeredById], references: [id])

  @@map("down_payments")
}

model SaleOrderItem {
  id          String  @id @default(uuid())
  saleOrderId String  @map("sale_order_id")
  productId   String? @map("product_id") // null = item de servicio / línea libre
  description String? // requerido cuando productId es null
  batchId     String? @map("batch_id")
  warehouseId String? @map("warehouse_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)

  // Notas/especificaciones opcionales por línea (dimensiones, materiales,
  // etc.) — uso libre, pensado para presupuestos de rubros con líneas a
  // medida (carpintería, herrería). No afecta precio ni stock.
  specNotes String? @map("spec_notes")

  // IVA breakdown (populated at sale time from product.ivaTaxRate)
  ivaRate             Decimal? @map("iva_rate") @db.Decimal(5, 2)
  ivaAmount           Decimal? @map("iva_amount") @db.Decimal(12, 2)
  unitPriceWithoutIva Decimal? @map("unit_price_without_iva") @db.Decimal(12, 2)

  // Precio con interés de crédito ya aplicado — solo se completa en ventas a
  // crédito (null en contado). Se calcula server-side una sola vez, al crear
  // el ítem, a partir de la tasa resuelta contra el CreditPlan del pedido —
  // nunca lo manda el cliente. Facturación y el contrato generado deben
  // preferir este valor sobre unitPrice cuando esté presente.
  financedUnitPrice Decimal? @map("financed_unit_price") @db.Decimal(12, 2)

  // Trazabilidad de combo — el pedido se arma como líneas normales (una por
  // producto componente), estas 2 columnas solo permiten reagruparlas
  // visualmente y saber de qué combo salieron. No afectan stock, IVA, precio
  // financiado ni ninguna otra lógica — cada línea se procesa exactamente
  // igual que si se hubiese agregado producto por producto.
  comboId      String? @map("combo_id")
  comboGroupId String? @map("combo_group_id")

  saleOrder    SaleOrder     @relation(fields: [saleOrderId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  batch        ProductBatch? @relation(fields: [batchId], references: [id])
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  productUnits ProductUnit[]
  combo        SaleCombo?    @relation(fields: [comboId], references: [id])

  @@map("sale_order_items")
}

model SaleCombo {
  id                 String         @id @default(uuid())
  tenantId           String         @map("tenant_id")
  name               String
  description        String?
  priceMode          ComboPriceMode @default(FIXED) @map("price_mode")
  fixedPrice         Decimal?       @map("fixed_price") @db.Decimal(12, 2)
  discountPercentage Decimal?       @map("discount_percentage") @db.Decimal(5, 2)
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  items     SaleComboItem[]
  saleItems SaleOrderItem[]

  @@map("sale_combos")
}

model SaleComboItem {
  id        String @id @default(uuid())
  comboId   String @map("combo_id")
  productId String @map("product_id")
  quantity  Int

  combo   SaleCombo @relation(fields: [comboId], references: [id])
  product Product   @relation(fields: [productId], references: [id])

  @@map("sale_combo_items")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  // Null para invoiceType=INTEREST (no corresponde a ningún pedido de venta,
  // se referencia por paymentReceiptId en su lugar) — sigue @unique porque
  // Postgres permite múltiples NULL bajo un unique, así que la garantía "una
  // sola factura de venta por pedido" queda intacta.
  saleOrderId String?       @unique @map("sale_order_id")
  invoiceType InvoiceType   @default(SALE) @map("invoice_type")
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime?     @map("issued_at")
  dueDate     DateTime?     @map("due_date")
  total       Decimal       @db.Decimal(12, 2)
  notes       String?

  // Solo para invoiceType=INTEREST: qué recibo de cobro generó esta factura.
  paymentReceiptId String? @unique @map("payment_receipt_id")

  // Numbering (timbrado / serie) — calculado en el servidor al emitir, nunca
  // aceptado del cliente. establecimiento/puntoExpedicion/sequential son la
  // fuente de verdad; invoiceNumber/invoicePrefix son el string formateado
  // para mostrar/imprimir ("001-002-0000123").
  establecimiento String? @map("establecimiento")
  puntoExpedicion String? @map("punto_expedicion")
  sequential      Int?    @map("sequential")
  invoiceNumber   String? @map("invoice_number")
  invoicePrefix   String? @map("invoice_prefix")

  // Payment details (populated on issue)
  paymentMethod PaymentMethod? @map("payment_method")

  // PDF storage — pdfUrl queda reservado para la copia alojada por SIFEN
  // cuando exista facturación electrónica; pdfFileId es el PDF interno
  // generado hoy desde la plantilla del tenant (módulo Documentos).
  pdfUrl    String?     @map("pdf_url")
  pdfFileId String?     @unique @map("pdf_file_id")
  pdfFile   FileRecord? @relation("InvoicePdf", fields: [pdfFileId], references: [id])

  // SIFEN / e-billing fields (null until electronic billing integration)
  cdc          String? // Código de Control Digital
  xmlContent   String?   @map("xml_content")
  qrUrl        String?   @map("qr_url")
  electronicAt DateTime? @map("electronic_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  saleOrder          SaleOrder?           @relation(fields: [saleOrderId], references: [id])
  paymentReceipt     PaymentReceipt?      @relation(fields: [paymentReceiptId], references: [id])
  items              InvoiceItem[]
  accountsReceivable AccountsReceivable?
  creditNotes        CreditNote[]

  @@unique([tenantId, establecimiento, puntoExpedicion, sequential])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // IVA breakdown
  ivaRate             Decimal? @map("iva_rate") @db.Decimal(5, 2)
  ivaAmount           Decimal? @map("iva_amount") @db.Decimal(12, 2)
  unitPriceWithoutIva Decimal? @map("unit_price_without_iva") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model CreditNote {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  invoiceId String           @map("invoice_id")
  number    String?          @map("number")
  reason    String
  total     Decimal          @db.Decimal(12, 2)
  status    CreditNoteStatus @default(ISSUED)
  issuedAt  DateTime         @default(now()) @map("issued_at")
  createdAt DateTime         @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("credit_notes")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model AccountsReceivable {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  invoiceId  String    @unique @map("invoice_id")
  amount     Decimal   @db.Decimal(12, 2)
  paidAmount Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status     ARStatus  @default(PENDING)
  dueDate    DateTime? @map("due_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  paymentRecords   PaymentRecord[]
  collectionVisits CollectionVisit[]

  @@map("accounts_receivable")
}

model PaymentRecord {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  accountsReceivableId String        @map("accounts_receivable_id")
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date")
  reference            String?
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  accountsReceivable AccountsReceivable @relation(fields: [accountsReceivableId], references: [id])

  @@map("payment_records")
}

// Espejo de AccountsReceivable pero del lado de Compras — se genera al
// recibir mercadería (purchase.receipt.created, listener dentro del propio
// módulo procurement), no al confirmar la orden ni con una "factura de
// proveedor" manual. Ver procurement-on-receipt.listener.ts.
model AccountsPayable {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  purchaseReceiptId String    @unique @map("purchase_receipt_id")
  supplierId        String    @map("supplier_id")
  amount            Decimal   @db.Decimal(12, 2)
  paidAmount        Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status            APStatus  @default(PENDING)
  dueDate           DateTime? @map("due_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  purchaseReceipt  PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  supplierPayments SupplierPayment[]

  @@map("accounts_payable")
}

model SupplierPayment {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  accountsPayableId String        @map("accounts_payable_id")
  amount            Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentDate       DateTime      @map("payment_date")
  reference         String?
  notes             String?
  createdById       String?       @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  accountsPayable AccountsPayable @relation(fields: [accountsPayableId], references: [id])
  createdBy       User?           @relation(fields: [createdById], references: [id])

  @@map("supplier_payments")
}

// ─── HR ───────────────────────────────────────────────────────────────────────

model Area {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  parentId String? @map("parent_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  parent    Area?      @relation("AreaHierarchy", fields: [parentId], references: [id])
  children  Area[]     @relation("AreaHierarchy")
  employees Employee[]
  positions Position[]

  @@unique([tenantId, name])
  @@map("areas")
}

model Position {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  areaId   String? @map("area_id")
  roleId   String? @map("role_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  area      Area?      @relation(fields: [areaId], references: [id])
  role      Role?      @relation(fields: [roleId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
  @@map("positions")
}

model Employee {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  userId         String? @unique @map("user_id")
  employeeNumber Int     @map("employee_number")
  employeeCode   String? @map("employee_code")
  areaId         String? @map("area_id")
  positionId     String? @map("position_id")
  managerId      String? @map("manager_id")
  branchId       String? @map("branch_id")

  // Personal
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  documentType   DocumentType   @default(CI) @map("document_type")
  documentNumber String         @map("document_number")
  ci             String?
  ipsNumber      String?        @map("ips_number")
  ruc            String?
  birthDate      DateTime       @map("birth_date")
  gender         Gender?
  nationality    String?
  maritalStatus  MaritalStatus? @map("marital_status")

  // Contact
  phone                    String?
  mobilePhone              String? @map("mobile_phone")
  address                  String?
  city                     String?
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  // Employment
  hireDate        DateTime     @map("hire_date")
  terminationDate DateTime?    @map("termination_date")
  contractType    ContractType @default(PERMANENT) @map("contract_type")
  // Puede ser asignado como repartidor en Logística — separado de
  // contractType (que distingue interno/externo, no "hace repartos").
  isCourier       Boolean      @default(false) @map("is_courier")

  // Payroll (PYG — integer, no decimals)
  baseSalary    Int           @map("base_salary")
  paymentMethod PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  bankName      String?       @map("bank_name")
  bankAccount   String?       @map("bank_account")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  area               Area?               @relation(fields: [areaId], references: [id])
  position           Position?           @relation(fields: [positionId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  manager            Employee?           @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  subordinates       Employee[]          @relation("EmployeeHierarchy")
  leaves             Leave[]
  leaveBalances      LeaveBalance[]
  payrollItems       PayrollRecordItem[]
  approvedLeaves     Leave[]             @relation("LeaveApprover")
  assignedDeliveries DeliveryNote[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, documentType, documentNumber])
  @@map("employees")
}

model Leave {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  employeeId   String      @map("employee_id")
  approvedById String?     @map("approved_by_id")
  type         LeaveType
  status       LeaveStatus @default(PENDING)
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  days         Int
  notes        String?
  approvedAt   DateTime?   @map("approved_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  employee   Employee  @relation(fields: [employeeId], references: [id])
  approvedBy Employee? @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@map("leaves")
}

model LeaveBalance {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  employeeId String @map("employee_id")
  year       Int
  entitled   Int
  taken      Int    @default(0)
  pending    Int    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year])
  @@map("leave_balances")
}

model PayrollConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  minimumWage     Int      @map("minimum_wage")
  ipsEmployeeRate Decimal  @default(0.0900) @map("ips_employee_rate") @db.Decimal(5, 4)
  ipsEmployerRate Decimal  @default(0.1650) @map("ips_employer_rate") @db.Decimal(5, 4)
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payroll_config")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  period      String // "2024-12" format
  status      PayrollStatus @default(PENDING)
  processedAt DateTime?     @map("processed_at")
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  items  PayrollRecordItem[]

  @@unique([tenantId, period])
  @@map("payroll_records")
}

model PayrollRecordItem {
  id              String @id @default(uuid())
  payrollRecordId String @map("payroll_record_id")
  employeeId      String @map("employee_id")

  // All amounts in PYG (integer)
  baseSalary  Int     @map("base_salary")
  bonuses     Int     @default(0)
  deductions  Int     @default(0)
  ipsEmployee Int     @map("ips_employee")
  ipsEmployer Int     @map("ips_employer")
  irp         Int     @default(0)
  aguinaldo   Int     @default(0)
  grossSalary Int     @map("gross_salary")
  netSalary   Int     @map("net_salary")
  notes       String?

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id])

  @@unique([payrollRecordId, employeeId])
  @@map("payroll_record_items")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  module     String
  action     String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, module])
  @@map("audit_logs")
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

model AlertConfig {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  type      AlertType
  channel   AlertChannel @default(SYSTEM)
  isActive  Boolean      @default(true) @map("is_active")
  threshold Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@map("alert_configs")
}

// ─── Documents ────────────────────────────────────────────────────────────────

enum DocType {
  INTERNAL // Políticas, manuales, reglamentos internos
  CONTRACT // Contratos con clientes o proveedores
  COMPLIANCE // Habilitaciones, registros fiscales, certificados
  BILLING // Plantillas de facturación (factura, recibo de dinero)
}

enum DocVisibility {
  PUBLIC // Todos los usuarios del tenant con documents:read
  PRIVATE // Solo el autor + documents:manage
  ROLE_BASED // Solo los roles listados en allowedRoles
}

enum DocContentFormat {
  TIPTAP // Editor WYSIWYG — contenido en JSON de TipTap
  HTML // HTML/CSS crudo — control de layout fino (factura, recibo)
  DOCX // Archivo .docx subido, usado tal cual como plantilla
}

enum TemplateKind {
  SALE_CONTRACT // Contrato de compra-venta, generado automáticamente al emitir factura de venta a crédito
  INVOICE // Factura (contado o crédito), generada automáticamente al emitir
  PAYMENT_RECEIPT // Recibo de dinero, generado automáticamente al cobrar una cuota
  QUOTE // Presupuesto, generado automáticamente al crear un pedido orderType=QUOTE
  INTEREST_INVOICE // Factura de intereses moratorios, generada automáticamente al cobrar una cuota con recargos
}

model DocumentCategory {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]

  @@unique([tenantId, name])
  @@map("document_categories")
}

model Document {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  type         DocType
  title        String
  description  String?
  categoryId   String?       @map("category_id")
  tags         String[]      @default([])
  visibility   DocVisibility @default(PUBLIC)
  allowedRoles String[]      @default([]) @map("allowed_roles")

  // Archivo adjunto — vive en FileRecord (StorageDriver local/S3), 1:1
  fileRecordId String? @unique @map("file_record_id")

  // Entidad vinculada (contratos → cliente / orden)
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  // Compliance: fecha de vencimiento del documento
  expiresAt DateTime? @map("expires_at")

  // Body: JSON de TipTap (contentFormat=TIPTAP) o HTML/CSS crudo (contentFormat=HTML)
  content       String?
  contentFormat DocContentFormat @default(TIPTAP) @map("content_format")

  // Plantillas: documento reutilizado como fuente de generación automática
  isTemplate   Boolean       @default(false) @map("is_template")
  templateKind TemplateKind? @map("template_kind")
  variables    Json? // snapshot de variables resueltas al generar (auditoría)

  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  category   DocumentCategory? @relation(fields: [categoryId], references: [id])
  fileRecord FileRecord?       @relation(fields: [fileRecordId], references: [id])

  @@unique([tenantId, templateKind])
  @@map("documents")
}

// ─── Files ────────────────────────────────────────────────────────────────────

enum FileVisibility {
  PUBLIC // servible por URL directa/CDN, sin pasar por el endpoint autenticado
  PRIVATE // solo accesible vía GET /files/:id/download (permiso files:read)
}

model FileRecord {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  module       String
  entityType   String         @map("entity_type")
  entityId     String?        @map("entity_id")
  bucket       String         @default("local")
  key          String
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  uploadedBy   String?        @map("uploaded_by")
  url          String?
  checksum     String?
  visibility   FileVisibility @default(PRIVATE)
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  document   Document?
  tenantLogo Tenant?         @relation("TenantLogo")
  invoiceFor Invoice?        @relation("InvoicePdf")
  receiptFor PaymentReceipt? @relation("ReceiptPdf")

  @@map("file_records")
}

// ─── Credit ───────────────────────────────────────────────────────────────────

model CreditConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique @map("tenant_id")
  isEnabled           Boolean  @default(false) @map("is_enabled")
  // % máximo del sueldo del cliente admitido para cuota mensual de crédito —
  // null = el chequeo de capacidad de pago por sueldo no corre.
  maxIncomePercentage Decimal? @map("max_income_percentage") @db.Decimal(5, 2)
  // Día del mes (1-28, evita problemas de meses cortos) en que vencen todas
  // las cuotas de todos los créditos del tenant — no depende de la fecha de
  // compra de cada cliente.
  dueDayOfMonth       Int      @default(5) @map("due_day_of_month")
  // Días de tolerancia después del vencimiento antes de empezar a devengar
  // mora (0 = sin tolerancia, se cobra desde el día siguiente al vencimiento).
  moraGraceDays       Int      @default(0) @map("mora_grace_days")
  // Meses de mora (períodos de 30 días desde que vence la tolerancia) a
  // partir de los cuales un cliente entra a la lista de Morosos para
  // gestionar su reporte a un buró de crédito externo. null = deshabilitado.
  delinquencyThresholdMonths Int? @map("delinquency_threshold_months")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  plans              CreditPlan[]
  interestComponents InterestComponent[]

  @@map("credit_configs")
}

model SalesConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id")
  combosEnabled Boolean  @default(false) @map("combos_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("sales_config")
}

model CreditBureauConfig {
  id             String                     @id @default(uuid())
  tenantId       String                     @unique @map("tenant_id")
  isEnabled      Boolean                    @default(false) @map("is_enabled")
  checkFrequency CreditBureauCheckFrequency @default(EVERY_REQUEST) @map("check_frequency")
  // Nombre del proveedor activo — hoy solo existe "manual" (registro a mano
  // por el analista). Preparado para que un proveedor real (Equifax u otro)
  // se enchufe más adelante sin cambiar el resto del flujo.
  providerName   String                     @default("manual") @map("provider_name")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

