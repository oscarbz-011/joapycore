generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum Industry {
  electrodomesticos
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum PurchaseType {
  LOCAL
  IMPORT
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

// ─── Core ─────────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid())
  name      String
  industry  Industry     @default(electrodomesticos)
  plan      String       @default("trial")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users          User[]
  roles          Role[]
  tenantModules  TenantModule[]
  categories     Category[]
  brands         Brand[]
  products       Product[]
  productUnits   ProductUnit[]
  stockMovements StockMovement[]
  customers      Customer[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  saleOrders     SaleOrder[]
  invoices       Invoice[]

  @@map("tenants")
}

model UserPermission {
  userId       String @map("user_id")
  permissionId String @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model TenantModule {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  moduleName String  @map("module_name")
  active     Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleName])
  @@map("tenant_modules")
}

model User {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  userPermissions UserPermission[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isSystem Boolean @default(false) @map("is_system")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Brand {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

model Product {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  categoryId   String    @map("category_id")
  brandId      String    @map("brand_id")
  model        String?
  name         String
  description  String?
  isSerialized Boolean   @default(false) @map("is_serialized")
  unit         String    @default("unidad")
  costPrice    Decimal   @db.Decimal(12, 2) @map("cost_price")
  salePrice    Decimal   @db.Decimal(12, 2) @map("sale_price")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  brand              Brand               @relation(fields: [brandId], references: [id])
  units              ProductUnit[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  saleOrderItems     SaleOrderItem[]

  @@map("products")
}

model ProductUnit {
  id                  String            @id @default(uuid())
  tenantId            String            @map("tenant_id")
  productId           String            @map("product_id")
  serialNumber        String            @map("serial_number")
  status              ProductUnitStatus @default(IN_STOCK)
  purchaseOrderItemId String?           @map("purchase_order_item_id")
  saleOrderItemId     String?           @map("sale_order_item_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  saleOrderItem     SaleOrderItem?     @relation(fields: [saleOrderItemId], references: [id])

  @@unique([tenantId, productId, serialNumber])
  @@map("product_units")
}

model StockMovement {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  productId   String            @map("product_id")
  type        StockMovementType
  quantity    Int
  referenceId String?           @map("reference_id")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

// ─── Procurement ──────────────────────────────────────────────────────────────

model Supplier {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  contactName String?   @map("contact_name")
  email       String?
  phone       String?
  address     String?
  taxId       String?   @map("tax_id")
  isImporter  Boolean   @default(false) @map("is_importer")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  supplierId   String              @map("supplier_id")
  purchaseType PurchaseType        @default(LOCAL) @map("purchase_type")
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  exchangeRate Decimal?            @db.Decimal(10, 4) @map("exchange_rate")
  customsDuty  Decimal?            @db.Decimal(5, 2) @map("customs_duty")
  customsRef   String?             @map("customs_ref")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  quantity        Int
  receivedQty     Int     @default(0) @map("received_qty")
  unitCost        Decimal @db.Decimal(12, 2) @map("unit_cost")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  productUnits  ProductUnit[]

  @@map("purchase_order_items")
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String?
  phone     String?
  address   String?
  taxId     String?   @map("tax_id")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  saleOrders SaleOrder[]

  @@map("customers")
}

model SaleOrder {
  id         String          @id @default(uuid())
  tenantId   String          @map("tenant_id")
  customerId String          @map("customer_id")
  status     SaleOrderStatus @default(DRAFT)
  orderDate  DateTime        @map("order_date")
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  items    SaleOrderItem[]
  invoice  Invoice?

  @@map("sale_orders")
}

model SaleOrderItem {
  id          String  @id @default(uuid())
  saleOrderId String  @map("sale_order_id")
  productId   String  @map("product_id")
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2) @map("unit_price")

  saleOrder    SaleOrder     @relation(fields: [saleOrderId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  productUnits ProductUnit[]

  @@map("sale_order_items")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  saleOrderId String        @unique @map("sale_order_id")
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?     @map("issued_at")
  dueDate     DateTime?     @map("due_date")
  total       Decimal       @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  saleOrder SaleOrder     @relation(fields: [saleOrderId], references: [id])
  items     InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2) @map("unit_price")
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}
