model CreditPlan {
  id             String   @id @default(uuid())
  creditConfigId String   @map("credit_config_id")
  installments   Int
  interestRate   Decimal  @map("interest_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  creditConfig CreditConfig @relation(fields: [creditConfigId], references: [id])

  @@unique([creditConfigId, installments])
  @@map("credit_plans")
}

enum InterestComponentFrequency {
  ONE_TIME // se cobra una vez, no crece con el tiempo (ej. gastos administrativos)
  DAILY // se acumula por día de atraso (ej. interés diario)
  MONTHLY // se acumula por período de 30 días de atraso
}

// Cada tenant define sus propios recargos por mora — pueden coexistir varios
// a la vez (ej. gastos administrativos ONE_TIME + interés diario DAILY), tal
// como lo pidió el usuario. Reemplaza por completo al viejo
// CreditConfig.moraRate, que nunca se expuso por API/UI y nunca se cobró.
model InterestComponent {
  id             String                      @id @default(uuid())
  tenantId       String                      @map("tenant_id")
  creditConfigId String                      @map("credit_config_id")
  name           String
  frequency      InterestComponentFrequency
  percentage     Decimal                     @db.Decimal(5, 2)
  // Solo aplica a MONTHLY: si true, el cargo crece con cada período vencido
  // (mes 1=10%, mes 2=20%, mes 3=30% — acumulación lineal, no interés
  // compuesto). Si false, se cobra el % base una sola vez apenas se cruza
  // el primer período y no vuelve a crecer. DAILY siempre es acumulativo
  // por diseño (más días = más interés); ONE_TIME nunca lo es.
  cumulative     Boolean                     @default(false)
  isActive       Boolean                     @default(true) @map("is_active")
  order          Int                         @default(0)
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  creditConfig CreditConfig                @relation(fields: [creditConfigId], references: [id])
  charges      InstallmentInterestCharge[]

  @@map("interest_components")
}

// Cargo VIGENTE de un componente sobre una cuota — el scheduler nocturno lo
// recalcula cada noche a partir de cero (no es historial acumulativo de
// escritura, es "cuánto se debe HOY por este componente"). Cuando se cobra
// (total o parcialmente) se descuenta acá; el detalle efectivamente cobrado
// queda snapshoteado en PaymentReceiptItem, que sí es historial permanente.
model InstallmentInterestCharge {
  id             String   @id @default(uuid())
  installmentId  String   @map("installment_id")
  componentId    String   @map("component_id")
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  periodsElapsed Int      @default(0) @map("periods_elapsed")
  updatedAt      DateTime @updatedAt @map("updated_at")

  installment Installment       @relation(fields: [installmentId], references: [id])
  component   InterestComponent @relation(fields: [componentId], references: [id])

  @@unique([installmentId, componentId])
  @@map("installment_interest_charges")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Loan {
  id                String     @id @default(uuid())
  tenantId          String     @map("tenant_id")
  saleOrderId       String     @unique @map("sale_order_id")
  customerId        String     @map("customer_id")
  principal         Decimal    @db.Decimal(12, 2)
  interestRate      Decimal    @map("interest_rate") @db.Decimal(5, 2)
  totalAmount       Decimal    @map("total_amount") @db.Decimal(12, 2)
  totalInstallments Int        @map("total_installments")
  status            LoanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  saleOrder         SaleOrder          @relation(fields: [saleOrderId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  installments      Installment[]
  collectionVisits  CollectionVisit[]
  paymentAgreements PaymentAgreement[]
  paymentReceipts   PaymentReceipt[]
  delinquencyReports DelinquencyReport[]

  @@map("loans")
}

model Installment {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  loanId               String            @map("loan_id")
  number               Int
  dueDate              DateTime          @map("due_date")
  amount               Decimal           @db.Decimal(12, 2)
  paidAmount           Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paidAt               DateTime?         @map("paid_at")
  paymentMethod        PaymentMethod?    @map("payment_method")
  paymentReference     String?           @map("payment_reference")
  paymentDate          DateTime?         @map("payment_date")
  status               InstallmentStatus @default(PENDING)
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  loan             Loan                        @relation(fields: [loanId], references: [id])
  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  collectionVisits CollectionVisit[]
  receiptItems     PaymentReceiptItem[]
  interestCharges  InstallmentInterestCharge[]

  @@unique([loanId, number])
  @@index([tenantId, dueDate])
  @@map("installments")
}

// Comprobante de dinero recibido al cobrar una o más cuotas de un préstamo en
// una misma operación (payInstallment cubre una sola, payByAmount puede
// repartir un pago entre varias cuotas pendientes más antiguas — el recibo
// reflaja eso con una fila por cuota cubierta, no 1:1 con Installment).
// Numeración oficial de 13 dígitos (establecimiento-puntoExpedicion-secuencial),
// pero el secuencial lo autogenera el sistema — no es un documento fiscal SET.
model PaymentReceipt {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  loanId           String        @map("loan_id")
  customerId       String        @map("customer_id")
  branchId         String?       @map("branch_id")
  establecimiento  String        @map("establecimiento")
  puntoExpedicion  String        @map("punto_expedicion")
  sequential       Int           @map("sequential")
  receiptNumber    String        @map("receipt_number") // "001-002-0000001" formateado
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentReference String?       @map("payment_reference")
  collectedById    String?       @map("collected_by_id")
  issuedAt         DateTime      @default(now()) @map("issued_at")
  pdfFileId        String?       @unique @map("pdf_file_id")

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  loan        Loan                 @relation(fields: [loanId], references: [id])
  customer    Customer             @relation(fields: [customerId], references: [id])
  branch      Branch?              @relation(fields: [branchId], references: [id])
  collectedBy User?                @relation(fields: [collectedById], references: [id])
  pdfFile     FileRecord?          @relation("ReceiptPdf", fields: [pdfFileId], references: [id])
  items       PaymentReceiptItem[]
  // Factura de intereses moratorios generada a partir de este recibo (si el
  // cobro incluyó algún cargo INTEREST_COMPONENT) — FK vive en Invoice.
  interestInvoice Invoice?

  @@unique([tenantId, establecimiento, puntoExpedicion, sequential])
  @@map("payment_receipts")
}

enum PaymentReceiptItemKind {
  PRINCIPAL
  INTEREST_COMPONENT
}

model PaymentReceiptItem {
  id                String                 @id @default(uuid())
  receiptId         String                 @map("receipt_id")
  installmentId     String                 @map("installment_id")
  installmentNumber Int                    @map("installment_number")
  amountApplied     Decimal                @map("amount_applied") @db.Decimal(12, 2)
  kind              PaymentReceiptItemKind @default(PRINCIPAL)
  // Snapshot del nombre del InterestComponent al momento de cobrarlo — solo
  // se completa para kind=INTEREST_COMPONENT. Sobrevive si el componente se
  // renombra o desactiva después; el recibo histórico no debe cambiar.
  componentName     String?                @map("component_name")

  receipt     PaymentReceipt @relation(fields: [receiptId], references: [id])
  installment Installment    @relation(fields: [installmentId], references: [id])

  @@map("payment_receipt_items")
}

// ─── Pricing ──────────────────────────────────────────────────────────────────

model PricingConfig {
