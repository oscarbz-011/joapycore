DATABASE_URL="YOUR_DATABASE_URL"

JWT_ACCESS_SECRET="YOUR_ACCESS_SECRET"
JWT_ACCESS_EXPIRES_IN="YOUR_ACCESS_TOKEN_EXPIRATION_TIME"
JWT_REFRESH_EXPIRES_IN="YOUR_REFRESH_TOKEN_EXPIRATION_TIME"

# Secretos: mínimo 32 caracteres (el backend no arranca si faltan o son cortos).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cifra las contraseñas temporales que se muestran al crear un usuario.
TEMP_PASSWORD_KEY="YOUR_TEMP_PASSWORD_KEY"

PORT="YOUR_PORT_NUMBER"

# Storage — driver "local" (default) escribe a disco, "s3" sirve cualquier
# backend S3-compatible (AWS S3, MinIO, Cloudflare R2, etc).
STORAGE_DRIVER="local"
UPLOADS_DIR="uploads"

# Solo se usan cuando STORAGE_DRIVER=s3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="joapycore"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="YOUR_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="true"

# SMTP — usado para enviar documentos (contratos, facturas) por email.
# Si SMTP_HOST queda vacío, el envío de email falla explícitamente al intentarse.
# Para desarrollo local con el maildev de docker-compose: host "localhost", puerto 1025,
# sin usuario/contraseña — los emails se ven en http://localhost:1080.
SMTP_HOST="YOUR_SMTP_HOST"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM="no-reply@joapycore.local"

# Gotenberg — convierte plantillas .docx a PDF (LibreOffice headless dentro
# de un contenedor Docker, en vez de requerir LibreOffice instalado en cada
# máquina de desarrollo). Para desarrollo local con el gotenberg de
# docker-compose: http://localhost:3009
GOTENBERG_URL="http://localhost:3009"
