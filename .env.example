# Usuarios y claves de los servicios de docker-compose.yml. Copiar a .env (no
# se sube a git) y cambiar las claves. Postgres solo lee estas variables al
# crear la base por primera vez: para cambiar la clave de una base que ya
# existe, ALTER USER dentro del contenedor y actualizar DATABASE_URL en BACK/.env.
POSTGRES_USER="joapycore"
POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD"
POSTGRES_DB="joapycore"

# Mínimo 8 caracteres. Si se usa STORAGE_DRIVER=s3 con este MinIO, S3_ACCESS_KEY
# y S3_SECRET_KEY de BACK/.env tienen que ser una clave de acceso creada en su consola.
MINIO_ROOT_USER="joapycore"
MINIO_ROOT_PASSWORD="YOUR_MINIO_ROOT_PASSWORD"
